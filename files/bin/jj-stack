#!/usr/bin/env sh
# ruff: noqa: E402

"""true"
if command -v uv >/dev/null; then
  exec uv run --script "$0" "$@"
elif command -v pipx >/dev/null; then
  exec pipx run "$0" "$@"
else
  echo "Neither uv nor pipx are available" >&2
  exit 1
fi
"""

# /// script
# requires-python = ">=3.11"
# dependencies = ["markdown-it-py==4.2.0"]
# ///

"""Command-line boundary for recoverable jj stack synchronization."""

import argparse
import sys
from pathlib import Path

import jj_stack_sync as sync


def positive_number(value: str) -> int:
    try:
        number = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("must be a positive integer") from None
    if number <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return number


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="jj stack", allow_abbrev=False)
    commands = result.add_subparsers(dest="command", required=True)
    command = commands.add_parser("sync", allow_abbrev=False)
    command.add_argument("--pr", type=positive_number)
    command.add_argument("--new", action="store_true")
    command.add_argument("-r", dest="revision")
    command.add_argument("--base")
    command.add_argument("--remote")
    command.add_argument("--replace-pr", action="append", default=[], type=positive_number)
    command.add_argument("--force-local-wins", action="store_true")
    command.add_argument("--dry-run", action="store_true")
    command.add_argument("--yes", action="store_true")
    return result


def intent_from_args(
    args: argparse.Namespace, cli: argparse.ArgumentParser
) -> sync.SyncIntent:
    if args.new:
        if args.pr is not None or args.replace_pr or args.force_local_wins:
            cli.error("--new is incompatible with --pr, --replace-pr, and --force-local-wins")
        if args.revision is None:
            cli.error("--new requires -r")
        return sync.NewSyncIntent(args.revision, args.base)
    if args.base is not None:
        cli.error("--base is only valid with --new")
    if args.replace_pr and args.revision is None:
        cli.error("--replace-pr requires -r")
    if args.force_local_wins and args.revision is None:
        cli.error("--force-local-wins requires -r")
    if args.replace_pr and args.force_local_wins:
        cli.error("--replace-pr is incompatible with --force-local-wins")
    return sync.ExistingSyncIntent(
        args.pr,
        args.revision,
        tuple(args.replace_pr),
        args.force_local_wins,
    )


def run_sync(args: argparse.Namespace, cli: argparse.ArgumentParser) -> int:
    intent = intent_from_args(args, cli)
    workspace = Path.cwd()
    github = sync.GitHubAPI(workspace=workspace)

    def confirm(command: sync.SyncCommandPlan) -> bool:
        print(sync.render_sync_command(command))
        if args.yes:
            return True
        if not sys.stdin.isatty():
            cli.error("mutation requires --yes when stdin is noninteractive")
        return input("Apply this plan? [y/N] ").strip().lower() in {"y", "yes"}

    command, result = sync.execute_sync_command(
        workspace,
        github,
        intent,
        requested_remote=args.remote,
        confirm=None if args.dry_run else confirm,
        dry_run=args.dry_run,
    )
    if command is not None and args.dry_run:
        print(sync.render_sync_command(command))
    elif command is not None and isinstance(command.value, sync.Blocked):
        print(sync.render_sync_command(command))
    print(sync.render_sync_command(result))
    return 2 if isinstance(result, sync.Stopped) else 0


def main(argv: list[str] | None = None) -> int:
    cli = parser()
    args = cli.parse_args(argv)
    try:
        return run_sync(args, cli)
    except sync.Error as error:
        print(f"jj stack: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
