#!/usr/bin/env python3
"""Clone a repository with jj under the repos_root configured in clone.toml."""

import argparse
from dataclasses import dataclass
import os
from pathlib import Path
import subprocess
import sys
from tempfile import TemporaryDirectory
import tomllib
from urllib.parse import SplitResult, urlsplit


@dataclass(frozen=True)
class Repository:
    remote: str
    relative_path: Path


def normalize_github_url(url: SplitResult) -> SplitResult:
    """Select the repository identified by a GitHub HTTPS page URL."""
    parts = url.path.removeprefix("/").split("/")[:2]
    if len(parts) != 2:
        raise ValueError("expected a GitHub URL containing an owner and repository")
    parts[-1] = parts[-1].removesuffix(".git") + ".git"
    return url._replace(path="/" + "/".join(parts), query="", fragment="")


def repository(source: str) -> Repository:
    """Return the clone URL and relative destination for a repository reference."""
    remote = source.rstrip("/")
    if "://" in remote:
        normalized = remote
    elif "@" in remote and ":" in remote:
        # SCP syntax is not a URL; normalize only for parsing, not for cloning.
        normalized = "ssh://" + remote.replace(":", "/", 1)
    else:
        raise ValueError("expected an HTTPS/SSH URL or SCP-style SSH remote")

    url = urlsplit(normalized)
    if url.scheme not in ("https", "ssh") or not url.hostname:
        raise ValueError("expected an HTTPS/SSH URL or SCP-style SSH remote")
    if url.scheme == "https" and url.hostname == "github.com":
        url = normalize_github_url(url)
        remote = url.geturl()
    elif url.query or url.fragment:
        raise ValueError("queries and fragments are not supported")

    host = url.hostname
    parts = url.path.removeprefix("/").split("/")
    parts[-1] = parts[-1].removesuffix(".git")
    if host in (".", ".."):
        raise ValueError("invalid repository host")
    if any(part in ("", ".", "..") for part in parts):
        raise ValueError("repository path must not contain empty, '.' or '..' components")
    if host == "github.com" and not url.path.endswith(".git"):
        remote += ".git"
    return Repository(remote, Path(host, *parts))


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog="Examples: clone https://github.com/kamalmarhubi/dotfiles-nix; clone git@github.com:kamalmarhubi/dotfiles-nix.git",
    )
    parser.add_argument(
        "repository", help="Git repository URL, or a GitHub page URL for convenience"
    )
    args = parser.parse_args()
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    try:
        with (config_home / "clone.toml").open("rb") as config_file:
            repos_root = tomllib.load(config_file).get("repos_root")
        if not isinstance(repos_root, str) or not Path(repos_root).is_absolute():
            raise ValueError("clone.toml: repos_root must be an absolute path")
        repos = Path(repos_root)
        match repository(args.repository):
            case Repository(remote, relative_path):
                destination = repos / relative_path
    except (OSError, ValueError) as error:
        parser.error(str(error))
    if destination.exists(follow_symlinks=False):
        parser.exit(1, f"clone: destination already exists: {destination}\n")
    try:
        repos.mkdir(parents=True, exist_ok=True)
        with TemporaryDirectory(prefix=".clone-", dir=repos) as tmp:
            checkout = Path(tmp) / "repo"
            subprocess.run(
                ["jj", "git", "clone", remote, str(checkout)],
                check=True,
            )
            if destination.exists(follow_symlinks=False):
                raise FileExistsError(f"destination already exists: {destination}")
            destination.parent.mkdir(parents=True, exist_ok=True)
            checkout.rename(destination)
        # Optional result channel for shell integration; leave normal stdio alone.
        if result_fd := os.environ.get("CLONE_RESULT_FD"):
            with os.fdopen(int(result_fd), "w") as result:
                print(destination, file=result)
    except subprocess.CalledProcessError as error:
        return error.returncode
    except (OSError, ValueError) as error:
        parser.exit(1, f"clone: {error}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
