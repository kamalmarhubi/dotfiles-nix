class Error(Exception):
    pass


def command(
    args: list[str],
    *,
    cwd: str | None = None,
    env: dict[str, str] | None = None,
    stdin_text: str | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    if globals().get("VERBOSITY", 0) >= 2:
        print(f"+ {shlex.join(args)}", file=sys.stderr)
    result = subprocess.run(
        args,
        cwd=cwd,
        env=env,
        input=stdin_text,
        text=True,
        capture_output=True,
        check=False,
    )
    if globals().get("VERBOSITY", 0) >= 2:
        for output in (result.stdout, result.stderr):
            if output.strip():
                print(output.rstrip(), file=sys.stderr)
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise Error(f"`{shlex.join(args)}` failed" + (f":\n{detail}" if detail else ""))
    return result


def jj_command() -> list[str]:
    result = ["jj", "--color=never"]
    if root := os.environ.get("JJ_WORKSPACE_ROOT"):
        result.extend(["--repository", root])
    return result


JJ = jj_command()
INSPECTION_OPERATION: str | None = None
VERBOSITY = 0


def jj(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return command([*JJ, *args], check=check)


def jj_inspect(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    operation = INSPECTION_OPERATION or "@"
    return command([*JJ, f"--at-op={operation}", *args], check=check)


def jj_output(*args: str) -> str:
    return jj_inspect(*args).stdout


def revision_ids(revset: str) -> list[str]:
    return jj_output(
        "log",
        "--color=never",
        "--no-graph",
        "--reversed",
        "-r",
        revset,
        "-T",
        'commit_id ++ "\\n"',
    ).splitlines()


@dataclass(frozen=True)
class Selection:
    boundaries: tuple[str, ...]
    commits: tuple[str, ...]
    fork: str
    tip: str


def exactly_one(revset: str, what: str) -> str:
    result = jj_inspect(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        f"exactly({revset}, 1)",
        "-T",
        'commit_id ++ "\\n"',
        check=False,
    )
    values = result.stdout.splitlines()
    if result.returncode != 0 or len(values) != 1:
        raise Error(f"requested history must have exactly one {what}")
    return values[0]


def git_commit_exists(git_root: str, oid: str) -> bool:
    return (
        command(
            [
                "git",
                "--no-replace-objects",
                "-C",
                git_root,
                "cat-file",
                "-e",
                f"{oid}^{{commit}}",
            ],
            check=False,
        ).returncode
        == 0
    )


def ensure_git_commit(git_root: str, remote: str, oid: str) -> None:
    shallow = command(
        ["git", "-C", git_root, "rev-parse", "--is-shallow-repository"]
    ).stdout.strip()
    if shallow == "true":
        raise Error(
            "shallow Git repositories are not supported because live-base ancestry "
            "cannot be validated without changing shallow metadata"
        )
    if shallow != "false":
        raise Error("could not determine whether the Git repository is shallow")
    if git_commit_exists(git_root, oid):
        return
    fetched = command(
        [
            "git",
            "-C",
            git_root,
            "fetch",
            "--no-tags",
            "--no-write-fetch-head",
            "--no-auto-maintenance",
            "--no-write-commit-graph",
            "--no-recurse-submodules",
            remote,
            oid,
        ],
        check=False,
    )
    if fetched.returncode != 0 or not git_commit_exists(git_root, oid):
        detail = fetched.stderr.strip() or fetched.stdout.strip()
        raise Error(
            f"could not fetch exact live base commit {oid[:12]} without updating refs"
            + (f":\n{detail}" if detail else "")
        )


def git_fork(git_root: str, tip: str, base_oid: str) -> str:
    result = command(
        [
            "git",
            "--no-replace-objects",
            "-C",
            git_root,
            "merge-base",
            "--all",
            tip,
            base_oid,
        ],
        check=False,
    )
    forks = result.stdout.splitlines()
    if result.returncode != 0 or not forks:
        raise Error("requested history has no common ancestor with the live base")
    if len(forks) != 1:
        raise Error(
            "requested history has multiple merge bases with the live base; "
            "restack it onto the current base"
        )
    return forks[0]


def validate_boundaries(
    boundaries: list[str],
    base_oid: str,
    git_root: str,
    remote: str,
    *,
    reject_divergence: bool = True,
) -> Selection:
    if not boundaries:
        raise Error("revset selects no PR boundaries")
    selected = "(" + " | ".join(boundaries) + ")"
    tip = exactly_one(f"heads({selected})", "selected tip")
    ensure_git_commit(git_root, remote, base_oid)
    fork = git_fork(git_root, tip, base_oid)
    if revision_ids(fork) != [fork]:
        raise Error(f"Git merge base {fork[:12]} is not available in jj")
    if revision_ids(f"{fork} & root()"):
        raise Error("requested history forks at the virtual root")
    commits = revision_ids(f"{fork}..{tip}")
    if not commits or not set(boundaries) <= set(commits):
        raise Error("every selected PR boundary must be inside the fork-to-tip history")
    if reject_divergence and revision_ids(f"({fork}..{tip}) & divergent()"):
        raise Error("requested history contains divergent changes; resolve them first")
    if revision_ids(f"{selected} & hidden()"):
        raise Error("selected PR boundaries must be visible (not abandoned)")
    previous = fork
    for commit_id in commits:
        parents = revision_ids(f"parents({commit_id})")
        if parents != [previous]:
            raise Error(
                "fork-to-tip history must be a linear parent chain without merges; "
                f"{commit_id[:12]} does not directly follow {previous[:12]}"
            )
        previous = commit_id
    return Selection(tuple(boundaries), tuple(commits), fork, tip)


@dataclass(frozen=True)
class Revision:
    commit_id: str
    change_id: str
    local_bookmarks: tuple[str, ...]
    remote_bookmarks: tuple[str, ...]
    title: str
    body: str
    generated_bookmark: str


def _record_newline(state: StateInline, silent: bool) -> bool:
    offset = state.pos
    token_count = len(state.tokens)
    matched = _parse_newline(state, silent)
    if (
        matched
        and not silent
        and len(state.tokens) > token_count
        and state.tokens[-1].type == "softbreak"
    ):
        state.tokens[-1].meta["inline_offset"] = offset
    return matched


_MARKDOWN = MarkdownIt("commonmark").enable("table")
_MARKDOWN.inline.ruler.at("newline", _record_newline)


def reflow_markdown(body: str) -> str:
    tokens = _MARKDOWN.parse(body)
    line_endings = list(re.finditer(r"\r\n|\r|\n", body))
    edits = []
    for index, token in enumerate(tokens):
        if token.type != "paragraph_open" or token.level != 0:
            continue
        inline = tokens[index + 1]
        if inline.type != "inline" or inline.map is None:
            raise Error("markdown parser returned an unexpected paragraph structure")
        for child in inline.children or []:
            if child.type != "softbreak":
                continue
            offset = child.meta.get("inline_offset")
            if not isinstance(offset, int):
                raise Error("markdown parser returned a soft break without an offset")
            line = inline.map[0] + inline.content.count("\n", 0, offset)
            if line >= len(line_endings):
                raise Error("markdown parser returned an invalid soft-break offset")
            edits.append(line_endings[line].span())
    for start, end in reversed(edits):
        body = body[:start] + " " + body[end:]
    return body


def revision_details(
    revisions: list[str], remote: str, required_titles: set[str] | None = None
) -> list[Revision]:
    template = jj_inspect("config", "get", "templates.git_push_bookmark", check=False)
    if template.returncode != 0 or not (push_template := template.stdout.rstrip("\n")):
        raise Error("templates.git_push_bookmark is empty or unavailable")
    details = []
    for commit_id in revisions:
        identity = jj_output(
            "log",
            "--color=never",
            "--no-graph",
            "-r",
            commit_id,
            "-T",
            'change_id ++ "\\n"',
        ).splitlines()
        if len(identity) != 1:
            raise Error(f"could not read identity for revision {commit_id}")
        change_id = identity[0]
        local_output = jj_output(
            "log",
            "--color=never",
            "--no-graph",
            "-r",
            commit_id,
            "-T",
            'local_bookmarks.map(|b| b.name()).join("\\n")',
        )
        remote_output = jj_output(
            "log",
            "--color=never",
            "--no-graph",
            "-r",
            commit_id,
            "-T",
            f"remote_bookmarks.filter(|b| b.remote() == {json.dumps(remote)})"
            '.map(|b| b.name()).join("\\n")',
        )
        conflicts = list(
            filter(
                None,
                jj_output(
                    "log",
                    "--color=never",
                    "--no-graph",
                    "-r",
                    commit_id,
                    "-T",
                    f'local_bookmarks.filter(|b| b.conflict()).map(|b| b.name()).join("\\n") ++ "\\n" ++ '
                    f'remote_bookmarks.filter(|b| b.remote() == {json.dumps(remote)} && b.conflict()).map(|b| b.name()).join("\\n")',
                ).splitlines(),
            )
        )
        if conflicts:
            raise Error(
                f"revision {commit_id} has conflicted bookmark targets: "
                + ", ".join(conflicts)
            )
        description = jj_output(
            "log", "--color=never", "--no-graph", "-r", commit_id, "-T", "description"
        ).rstrip("\n")
        title, separator, body = description.partition("\n")
        if not title and (required_titles is None or commit_id in required_titles):
            raise Error(f"revision {commit_id} has no description title")
        if separator:
            body = reflow_markdown(body.removeprefix("\n"))
        generated = jj_output(
            "log", "--color=never", "--no-graph", "-r", commit_id, "-T", push_template
        )
        if not generated or any(char in generated for char in "\r\n\0"):
            raise Error(
                "templates.git_push_bookmark must produce one nonempty line per revision"
            )
        details.append(
            Revision(
                commit_id,
                change_id,
                tuple(filter(None, local_output.splitlines())),
                tuple(filter(None, remote_output.splitlines())),
                title,
                body,
                generated,
            )
        )
    return details


def push_remote(override: str | None) -> str:
    if override:
        return override
    configured = jj_inspect("config", "get", "git.push", check=False)
    if configured.returncode == 0 and (remote := configured.stdout.strip()):
        return remote
    return "origin"


@dataclass(frozen=True)
class Repository:
    git_root: str
    name_with_owner: str
    gh_repo: str
    host: str
    base: str
    url: str


def github_repository(remote: str, base_override: str | None) -> Repository:
    git_root = jj_output("git", "root").strip()
    if not git_root:
        raise Error("could not find the jj Git store")
    remote_url = command(
        ["git", "-C", git_root, "remote", "get-url", "--push", remote]
    ).stdout.strip()
    view = command(
        [
            "gh",
            "repo",
            "view",
            remote_url,
            "--json",
            "nameWithOwner,url,defaultBranchRef",
        ],
        cwd=git_root,
    )
    try:
        metadata = json.loads(view.stdout)
        name_with_owner = metadata["nameWithOwner"]
        url = metadata["url"]
        base = base_override or metadata["defaultBranchRef"]["name"]
    except (KeyError, TypeError, json.JSONDecodeError) as exc:
        raise Error("could not read repository metadata from `gh repo view`") from exc
    host = urlparse(url).hostname
    if not host:
        raise Error(f"could not determine GitHub host from {url}")
    gh_repo = (
        name_with_owner if host.lower() == "github.com" else f"{host}/{name_with_owner}"
    )
    return Repository(git_root, name_with_owner, gh_repo, host, base, url)


@dataclass(frozen=True)
class PullRequest:
    node_id: str
    number: int
    url: str
    state: str
    merged: bool
    draft: bool
    title: str
    body: str
    head: str
    head_oid: str
    base: str
    base_oid: str
    commits: int
    stack_id: str | None
    stack_number: int | None
    auto_merge: bool = False
    merge_queue: bool = False
    repository: str | None = None
    head_repository: str | None = None


@dataclass
class StackSnapshot:
    node_id: str | None
    number: int | None
    entries: list[PullRequest]
    discovered: dict[str, PullRequest] = field(default_factory=dict)

    @property
    def merged(self) -> list[PullRequest]:
        return [pr for pr in self.entries if pr.merged]

    @property
    def active(self) -> list[PullRequest]:
        return [pr for pr in self.entries if pr.state == "OPEN"]

    @property
    def closed(self) -> list[PullRequest]:
        return [pr for pr in self.entries if pr.state == "CLOSED" and not pr.merged]


def open_suffix_root(stack: StackSnapshot, base_oid: str) -> str:
    return stack.merged[-1].head_oid if stack.merged else base_oid


def verify_stack_snapshot_unchanged(
    before: StackSnapshot,
    after: StackSnapshot,
    expected_head_refs: dict[str, str] | None = None,
    expected_base_refs: dict[str, str] | None = None,
) -> None:
    def identity(
        stack: StackSnapshot,
        head_refs: dict[str, str] | None = None,
        base_refs: dict[str, str] | None = None,
    ) -> tuple[object, ...]:
        def expected_oid(
            pr: PullRequest,
            refs: dict[str, str] | None,
            name: str,
            oid: str,
        ) -> str:
            if refs is not None and pr.state == "OPEN":
                return refs.get(name, oid)
            return oid

        return (
            stack.node_id,
            stack.number,
            tuple(
                (
                    pr.node_id,
                    pr.number,
                    pr.state,
                    pr.merged,
                    pr.draft,
                    pr.title,
                    pr.head,
                    expected_oid(pr, head_refs, pr.head, pr.head_oid),
                    pr.base,
                    expected_oid(pr, base_refs, pr.base, pr.base_oid),
                    pr.auto_merge,
                    pr.merge_queue,
                    pr.repository,
                    pr.head_repository,
                )
                for pr in stack.entries
            ),
        )

    if identity(before, expected_head_refs, expected_base_refs) != identity(after):
        raise Error(
            "GitHub stack membership, order, state, or refs changed during "
            "reconciliation; replan and retry"
        )


def graphql(
    query: str,
    variables: dict[str, object],
    gh_env: dict[str, str],
    git_root: str,
    failure: str,
) -> dict[str, object]:
    result = command(
        ["gh", "api", "graphql", "--input", "-"],
        cwd=git_root,
        env=gh_env,
        stdin_text=json.dumps({"query": query, "variables": variables}),
        check=False,
    )
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise Error(
            failure + (f": {result.stderr.strip()}" if result.stderr.strip() else "")
        ) from exc
    if not isinstance(response, dict):
        raise Error(
            failure + (f": {result.stderr.strip()}" if result.stderr.strip() else "")
        )
    errors = response.get("errors")
    if result.returncode != 0 or errors:
        detail = "; ".join(error.get("message", str(error)) for error in errors or [])
        raise Error(
            failure
            + (
                f": {detail or result.stderr.strip()}"
                if detail or result.stderr.strip()
                else ""
            )
        )
    try:
        return response["data"]
    except (KeyError, TypeError) as exc:
        raise Error(failure) from exc


_PR_FIELDS = """
  id number url state merged isDraft title body headRefName headRefOid
  baseRefName baseRefOid commits { totalCount }
  repository { nameWithOwner }
  headRepository { nameWithOwner }
  stack { id number }
  autoMergeRequest { enabledAt }
  mergeQueueEntry { id }
"""


def discover_merged_selectors(
    name_with_owner: str,
    selected_oids: list[str],
    gh_env: dict[str, str],
    git_root: str,
) -> dict[str, tuple[PullRequest, ...]]:
    """Return exact historical merged-stack PR matches for selected OIDs."""
    owner, name = name_with_owner.split("/", 1)
    result = {}
    for oid in selected_oids:
        query = f"""query($owner: String!, $name: String!, $oid: String!) {{
          repository(owner: $owner, name: $name) {{
            object(expression: $oid) {{
              ... on Commit {{
                associatedPullRequests(first: 100) {{
                  nodes {{
                    {_PR_FIELDS}
                    historical: commits(last: 1) {{
                      nodes {{ commit {{ oid }} }}
                    }}
                  }}
                  pageInfo {{ hasNextPage }}
                }}
              }}
            }}
          }}
        }}"""
        data = graphql(
            query,
            {"owner": owner, "name": name, "oid": oid},
            gh_env,
            git_root,
            f"could not verify historical pull request identity for {oid[:12]}",
        )
        try:
            repository = data["repository"]
            if repository is None:
                raise KeyError("repository")
            commit = repository["object"]
            if commit is None:
                continue
            connection = commit["associatedPullRequests"]
            if connection["pageInfo"]["hasNextPage"]:
                raise Error(
                    f"more than 100 pull requests contain {oid[:12]}; "
                    "historical identity is incomplete"
                )
            matches = []
            open_match = False
            for node in connection["nodes"]:
                head_repository = node.get("headRepository")
                repository_local = bool(
                    (node.get("repository") or {}).get("nameWithOwner", "").lower()
                    == name_with_owner.lower()
                    and head_repository
                    and head_repository.get("nameWithOwner", "").lower()
                    == name_with_owner.lower()
                )
                if (
                    node["state"] == "OPEN"
                    and node["headRefOid"] == oid
                    and repository_local
                ):
                    open_match = True
                historical = node["historical"]["nodes"]
                if not node["merged"]:
                    continue
                if len(historical) != 1:
                    raise Error(
                        f"could not establish the historical final commit of PR #{node['number']}"
                    )
                if historical[0]["commit"]["oid"] != oid:
                    continue
                if not repository_local:
                    raise Error(
                        f"PR #{node['number']} matches {oid[:12]}, but its repository-local "
                        "identity cannot be verified"
                    )
                pr = parse_pr(node)
                if pr.stack_id is not None:
                    matches.append(pr)
            if matches and open_match:
                raise Error(
                    f"selected OID {oid[:12]} is ambiguously both an open PR boundary "
                    "and a merged selector"
                )
            stack_ids = {pr.stack_id for pr in matches}
            if len(stack_ids) > 1:
                rendered = ", ".join(f"#{pr.number}" for pr in matches)
                raise Error(
                    f"merged selector {oid[:12]} identifies multiple GitHub stacks "
                    f"through {rendered}"
                )
            if matches:
                result[oid] = tuple(matches)
        except Error:
            raise
        except (KeyError, TypeError) as exc:
            raise Error(
                f"could not verify historical pull request identity for {oid[:12]}"
            ) from exc
    return result


def selector_stack(
    selectors: dict[str, tuple[PullRequest, ...]],
    gh_env: dict[str, str],
    git_root: str,
) -> StackSnapshot | None:
    stack_ids = {pr.stack_id for matches in selectors.values() for pr in matches}
    if not stack_ids:
        return None
    if len(stack_ids) != 1:
        raise Error("selected merged commits identify multiple GitHub stacks")
    stack_id = stack_ids.pop()
    assert stack_id is not None
    stack = fetch_stack(stack_id, gh_env, git_root)
    positions = {pr.node_id: index for index, pr in enumerate(stack.entries)}
    for oid, matches in selectors.items():
        if any(pr.node_id not in positions for pr in matches):
            raise Error(
                f"merged selector {oid[:12]} is not present in its reported GitHub stack"
            )
        if any(not stack.entries[positions[pr.node_id]].merged for pr in matches):
            raise Error(
                f"merged selector {oid[:12]} is not in the immutable merged prefix"
            )
    selector_items = list(selectors.items())
    for index, (lower_oid, lower_matches) in enumerate(selector_items):
        lower_positions = [positions[pr.node_id] for pr in lower_matches]
        for upper_oid, upper_matches in selector_items[index + 1 :]:
            upper_positions = [positions[pr.node_id] for pr in upper_matches]
            if revision_ids(f"{lower_oid} & ::{upper_oid}"):
                before, after = lower_positions, upper_positions
            elif revision_ids(f"{upper_oid} & ::{lower_oid}"):
                before, after = upper_positions, lower_positions
            else:
                continue
            if max(before) >= min(after):
                raise Error(
                    "locally comparable merged selectors contradict GitHub stack order: "
                    f"{lower_oid[:12]} and {upper_oid[:12]}"
                )
    return stack


def parse_pr(
    node: dict[str, object], stack: dict[str, object] | None = None
) -> PullRequest:
    try:
        pr_stack = stack or node.get("stack")
        return PullRequest(
            node_id=node["id"],
            number=node["number"],
            url=node["url"],
            state=node["state"],
            merged=node["merged"],
            draft=node["isDraft"],
            title=node["title"],
            body=node.get("body") or "",
            head=node["headRefName"],
            head_oid=node["headRefOid"],
            base=node["baseRefName"],
            base_oid=node["baseRefOid"],
            commits=node["commits"]["totalCount"],
            stack_id=pr_stack["id"] if pr_stack else None,
            stack_number=pr_stack["number"] if pr_stack else None,
            auto_merge=node.get("autoMergeRequest") is not None,
            merge_queue=node.get("mergeQueueEntry") is not None,
            repository=(node.get("repository") or {}).get("nameWithOwner"),
            head_repository=(node.get("headRepository") or {}).get("nameWithOwner"),
        )
    except (KeyError, TypeError) as exc:
        raise Error("could not read pull request data from GitHub") from exc


def discover_pull_requests(
    name_with_owner: str,
    bookmarks: list[str],
    gh_env: dict[str, str],
    git_root: str,
) -> dict[str, PullRequest]:
    if not bookmarks:
        return {}
    owner, name = name_with_owner.split("/", 1)
    declarations = ["$owner: String!", "$name: String!"]
    selections = []
    variables: dict[str, object] = {"owner": owner, "name": name}
    for index, bookmark in enumerate(bookmarks):
        variable = f"head{index}"
        declarations.append(f"${variable}: String!")
        variables[variable] = bookmark
        selections.append(
            f"pr{index}: pullRequests(first: 100, states: OPEN, headRefName: ${variable}) "
            f"{{ nodes {{ {_PR_FIELDS} }} pageInfo {{ hasNextPage }} }}"
        )
    query = f"query({', '.join(declarations)}) {{ repository(owner: $owner, name: $name) {{ {' '.join(selections)} }} }}"
    data = graphql(
        query, variables, gh_env, git_root, "could not look up pull requests on GitHub"
    )
    try:
        repository = data["repository"]
        if repository is None:
            raise KeyError("repository")
        result = {}
        for index, bookmark in enumerate(bookmarks):
            connection = repository[f"pr{index}"]
            if connection["pageInfo"]["hasNextPage"]:
                raise Error(
                    f"more than 100 open pull requests have head {bookmark}; cannot identify it safely"
                )
            nodes = [
                node
                for node in connection["nodes"]
                if (node.get("headRepository") or {}).get("nameWithOwner", "").lower()
                == name_with_owner.lower()
            ]
            if len(nodes) > 1:
                raise Error(f"multiple open pull requests have head {bookmark}")
            if nodes:
                result[bookmark] = parse_pr(nodes[0])
        return result
    except Error:
        raise
    except (KeyError, TypeError) as exc:
        raise Error("could not read pull requests from GitHub") from exc


def fetch_stack(stack_id: str, gh_env: dict[str, str], git_root: str) -> StackSnapshot:
    query = f"""query($id: ID!) {{
      node(id: $id) {{
        ... on PullRequestStack {{
          id number entries(first: 100) {{
            nodes {{ position pullRequest {{ {_PR_FIELDS} }} }}
            pageInfo {{ hasNextPage }}
          }}
        }}
      }}
    }}"""
    data = graphql(
        query, {"id": stack_id}, gh_env, git_root, "could not read GitHub stack"
    )
    stack = data.get("node")
    if stack is None:
        return StackSnapshot(None, None, [])
    try:
        entries_data = stack["entries"]
        if entries_data["pageInfo"]["hasNextPage"]:
            raise Error("GitHub stacks with more than 100 PRs are not supported")
        entries = [
            parse_pr(entry["pullRequest"], stack)
            for entry in sorted(
                entries_data["nodes"], key=lambda item: item["position"]
            )
        ]
        seen_unmerged = False
        for pr in entries:
            if pr.merged and seen_unmerged:
                raise Error(
                    "stack entries are not a merged prefix followed by unmerged PRs"
                )
            if not pr.merged:
                seen_unmerged = True
        return StackSnapshot(stack["id"], stack["number"], entries)
    except Error:
        raise
    except (KeyError, TypeError) as exc:
        raise Error("could not read GitHub stack") from exc


@dataclass(frozen=True)
class BaseTransition:
    node_id: str
    created_at: str
    previous: str
    current: str


@dataclass(frozen=True)
class RecoveryEvidence:
    first_pr_id: str
    transition: BaseTransition
    boundary: PullRequest
    stack_id: str
    stack_number: int


def pull_request_base_transitions(
    pr: PullRequest, gh_env: dict[str, str], git_root: str
) -> tuple[BaseTransition, ...]:
    transitions = []
    cursor = None
    while True:
        query = """query($id: ID!, $cursor: String) {
          node(id: $id) {
            ... on PullRequest {
              timelineItems(
                first: 100
                after: $cursor
                itemTypes: [BASE_REF_CHANGED_EVENT]
              ) {
                nodes {
                  ... on BaseRefChangedEvent {
                    id createdAt previousRefName currentRefName
                  }
                }
                pageInfo { hasNextPage endCursor }
              }
            }
          }
        }"""
        data = graphql(
            query,
            {"id": pr.node_id, "cursor": cursor},
            gh_env,
            git_root,
            f"could not read base history for PR #{pr.number}",
        )
        try:
            node = data["node"]
            if node is None:
                raise KeyError("node")
            timeline = node["timelineItems"]
            transitions.extend(
                BaseTransition(
                    event["id"],
                    event["createdAt"],
                    event["previousRefName"],
                    event["currentRefName"],
                )
                for event in timeline["nodes"]
            )
            page = timeline["pageInfo"]
            if not page["hasNextPage"]:
                return tuple(transitions)
            cursor = page["endCursor"]
            if not cursor:
                raise KeyError("endCursor")
        except (KeyError, TypeError) as exc:
            raise Error(f"could not read base history for PR #{pr.number}") from exc


def merged_pull_request_by_head(
    name_with_owner: str,
    head: str,
    gh_env: dict[str, str],
    git_root: str,
) -> PullRequest | None:
    owner, name = name_with_owner.split("/", 1)
    query = f"""query(
      $owner: String!, $name: String!, $head: String!
    ) {{
      repository(owner: $owner, name: $name) {{
        pullRequests(first: 2, states: [MERGED], headRefName: $head) {{
          totalCount
          nodes {{ {_PR_FIELDS} }}
        }}
      }}
    }}"""
    data = graphql(
        query,
        {"owner": owner, "name": name, "head": head},
        gh_env,
        git_root,
        f"could not identify merged PR with historical head {head}",
    )
    try:
        repository = data["repository"]
        if repository is None:
            raise KeyError("repository")
        connection = repository["pullRequests"]
        if connection["totalCount"] > 1:
            raise Error(
                f"historical branch {head} identifies multiple merged PRs; "
                "cannot choose a surviving stack"
            )
        nodes = connection["nodes"]
        if not nodes:
            return None
        if len(nodes) != 1:
            raise KeyError("nodes")
        pr = parse_pr(nodes[0])
        if (
            not pr.merged
            or pr.repository is None
            or pr.repository.lower() != name_with_owner.lower()
        ):
            raise Error(
                f"historical branch {head} does not identify one repository-local merged PR"
            )
        return pr
    except Error:
        raise
    except (KeyError, TypeError) as exc:
        raise Error(
            f"could not identify merged PR with historical head {head}"
        ) from exc


def recover_surviving_stack(
    selected: list[PullRequest],
    repo: Repository,
    gh_env: dict[str, str],
) -> tuple[StackSnapshot, RecoveryEvidence] | None:
    if not selected:
        return None
    if any(
        pr.state != "OPEN"
        or pr.stack_id is not None
        or pr.repository is None
        or pr.repository.lower() != repo.name_with_owner.lower()
        or pr.head_repository is None
        or pr.head_repository.lower() != repo.name_with_owner.lower()
        for pr in selected
    ):
        return None
    first = selected[0]
    transitions = pull_request_base_transitions(first, gh_env, repo.git_root)
    if not transitions:
        return None
    if len(transitions) != 1:
        raise Error(
            f"PR #{first.number} has multiple recorded base changes; "
            "cannot choose a surviving stack"
        )
    transition = transitions[0]
    if transition.current != first.base:
        raise Error(
            f"PR #{first.number} base history changed while resolving its stack target"
        )
    endpoints = {transition.previous, transition.current}
    candidates = endpoints - {repo.base}
    if repo.base not in endpoints or len(candidates) != 1:
        raise Error(
            f"PR #{first.number} base history does not identify one historical "
            "boundary branch"
        )
    candidate = candidates.pop()
    boundary = merged_pull_request_by_head(
        repo.name_with_owner, candidate, gh_env, repo.git_root
    )
    if boundary is None or boundary.stack_id is None:
        return None
    stack = fetch_stack(boundary.stack_id, gh_env, repo.git_root)
    if stack.node_id is None or stack.number is None:
        return None
    if not stack.entries or stack.entries[-1].node_id != boundary.node_id:
        raise Error(
            f"merged PR #{boundary.number} is not the final member of its surviving stack"
        )
    if any(not pr.merged for pr in stack.entries):
        raise Error(
            f"surviving stack {stack.number} has unexpected unmerged entries; "
            "cannot attach the selected PRs safely"
        )
    return stack, RecoveryEvidence(
        first.node_id,
        transition,
        boundary,
        stack.node_id,
        stack.number,
    )


def verify_recovery_suffix(
    evidence: RecoveryEvidence,
    stack: StackSnapshot,
    states: tuple["BoundaryState", ...],
    counts: tuple[int, ...],
    repo: Repository,
    remote: str,
) -> None:
    if (
        stack.node_id != evidence.stack_id
        or stack.number != evidence.stack_number
        or not stack.merged
        or stack.merged[-1].node_id != evidence.boundary.node_id
    ):
        raise Error("surviving stack target changed during recovery planning")
    if any(state.tracked_oid is None for state in states):
        raise Error(
            "historical stack recovery requires a tracked baseline for every PR"
        )
    if any(state.live_oid != state.tracked_oid for state in states):
        verify_mechanical_restack(
            states,
            open_suffix_root(stack, ""),
            counts,
            repo.git_root,
            remote,
            allow_restacked_first=True,
        )
    else:
        verify_live_suffix(
            states,
            open_suffix_root(stack, ""),
            counts,
            repo.git_root,
            remote,
            allow_restacked_first=True,
        )


def change_id_at(commit_id: str) -> str:
    values = jj_output(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        commit_id,
        "-T",
        'change_id ++ "\\n"',
    ).splitlines()
    if len(values) != 1:
        raise Error(f"could not identify jj change at {commit_id[:12]}")
    return values[0]


def resolve_heads(
    revisions: list[Revision],
    discovered: dict[str, PullRequest],
) -> tuple[list[str], dict[str, PullRequest]]:
    heads = []
    prs = {}
    for revision in revisions:
        candidates = (
            set(revision.local_bookmarks)
            | set(revision.remote_bookmarks)
            | {revision.generated_bookmark}
        )
        matches = {name: discovered[name] for name in candidates if name in discovered}
        unique_prs = {pr.node_id for pr in matches.values()}
        if len(unique_prs) > 1:
            rendered = ", ".join(
                f"{name} ({pr.url})" for name, pr in sorted(matches.items())
            )
            raise Error(
                f"revision {revision.commit_id} matches multiple open PRs: {rendered}"
            )
        if matches:
            head, pr = next(iter(matches.items()))
            head = pr.head
            prs[head] = pr
        elif len(revision.local_bookmarks) == 1:
            head = revision.local_bookmarks[0]
        elif len(revision.local_bookmarks) > 1:
            raise Error(
                f"revision {revision.commit_id} has ambiguous local bookmarks: "
                + ", ".join(revision.local_bookmarks)
            )
        elif len(revision.remote_bookmarks) == 1:
            head = revision.remote_bookmarks[0]
        elif len(revision.remote_bookmarks) > 1:
            raise Error(
                f"revision {revision.commit_id} has ambiguous selected-remote bookmarks: "
                + ", ".join(revision.remote_bookmarks)
            )
        else:
            head = revision.generated_bookmark
        if head.isdecimal():
            raise Error(f"bookmark is all-numeric and ambiguous to gh-stack: {head}")
        heads.append(head)
    duplicates = sorted({head for head in heads if heads.count(head) > 1})
    if duplicates:
        raise Error(
            "multiple selected revisions resolve to bookmark: " + ", ".join(duplicates)
        )
    return heads, prs


def inspect_existing_stack(
    name_with_owner: str,
    candidate_names: list[str],
    range_revisions: list[Revision],
    boundary_ids: tuple[str, ...],
    gh_env: dict[str, str],
    git_root: str,
    identified_stack: StackSnapshot | None = None,
) -> tuple[list[str], StackSnapshot]:
    discovered = discover_pull_requests(
        name_with_owner, candidate_names, gh_env, git_root
    )
    by_id = {revision.commit_id: revision for revision in range_revisions}
    boundaries = [by_id[commit_id] for commit_id in boundary_ids]
    heads, selected_prs = resolve_heads(boundaries, discovered)

    selected_changes = {revision.change_id for revision in boundaries}
    boundary_indexes = {
        index
        for index, revision in enumerate(range_revisions)
        if revision.commit_id in boundary_ids
    }
    for index, revision in enumerate(range_revisions):
        candidates = (
            set(revision.local_bookmarks)
            | set(revision.remote_bookmarks)
            | {revision.generated_bookmark}
        )
        existing = {
            discovered[name].node_id: discovered[name]
            for name in candidates
            if name in discovered
        }
        if len(existing) > 1:
            raise Error(
                f"revision {revision.commit_id} is associated with multiple open PRs"
            )
        if existing and revision.change_id not in selected_changes:
            pr = next(iter(existing.values()))
            before = [candidate for candidate in boundary_indexes if candidate < index]
            after = [candidate for candidate in boundary_indexes if candidate > index]
            location = ""
            if before and after:
                lower = range_revisions[max(before)].change_id[:8]
                upper = range_revisions[min(after)].change_id[:8]
                location = f"\nIt lies between selected boundaries {lower} and {upper}."
            elif after:
                upper = range_revisions[min(after)].change_id[:8]
                location = f"\nIt lies before selected boundary {upper}."
            elif before:
                lower = range_revisions[max(before)].change_id[:8]
                location = f"\nIt lies after selected boundary {lower}."
            change = revision.change_id[:8]
            raise Error(
                f"open PR #{pr.number} is on change {change} ({json.dumps(revision.title)}),\n"
                f"but that change is not selected as a PR boundary:\n{pr.url}\n"
                f"{location}\nInclude {change} in the revset, or close PR #{pr.number} before retrying."
            )
    stack_ids = {pr.stack_id for pr in selected_prs.values() if pr.stack_id is not None}
    if identified_stack is not None:
        stack_ids.add(identified_stack.node_id)
    if len(stack_ids) > 1:
        raise Error(
            "selected open PRs and merged selectors identify different GitHub stacks"
        )
    if not stack_ids:
        return heads, StackSnapshot(None, None, [], selected_prs)
    stack_id = stack_ids.pop()
    assert stack_id is not None
    snapshot = (
        identified_stack
        if identified_stack is not None and identified_stack.node_id == stack_id
        else fetch_stack(stack_id, gh_env, git_root)
    )
    snapshot.discovered = selected_prs
    return heads, snapshot


def remote_refs(git_root: str, remote: str) -> dict[str, str]:
    output = command(["git", "-C", git_root, "ls-remote", "--heads", remote]).stdout
    refs = {}
    for line in output.splitlines():
        oid, ref = line.split("\t", 1)
        refs[ref.removeprefix("refs/heads/")] = oid
    return refs


def fetched_remote_refs(git_root: str, remote: str) -> dict[str, str]:
    output = command(
        [
            "git",
            "-C",
            git_root,
            "for-each-ref",
            "--format=%(refname:strip=3)%09%(objectname)",
            f"refs/remotes/{remote}",
        ]
    ).stdout
    result = {}
    for line in output.splitlines():
        name, oid = line.split("\t", 1)
        if name != "HEAD":
            result[name] = oid
    return result


def jj_commit_exists(oid: str) -> bool:
    result = jj_inspect(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        oid,
        "-T",
        'commit_id ++ "\\n"',
        check=False,
    )
    return result.returncode == 0 and result.stdout.splitlines() == [oid]


def import_live_base(git_root: str, remote: str, base: str, expected_oid: str) -> None:
    if jj_commit_exists(expected_oid):
        return
    jj("git", "fetch", "--remote", remote, "--branch", base)
    begin_inspection_phase()
    imported_oid = fetched_remote_refs(git_root, remote).get(base)
    if imported_oid != expected_oid or not jj_commit_exists(expected_oid):
        raise Error(
            f"live base {base} changed while importing it into jj; replan and retry"
        )


def verify_planned_bookmarks(revisions: list[Revision], heads: list[str]) -> None:
    for revision, head in zip(revisions, heads, strict=True):
        if head not in revision.local_bookmarks:
            continue
        current = jj_output(
            "log",
            "--color=never",
            "--no-graph",
            "-r",
            revision.commit_id,
            "-T",
            'local_bookmarks.map(|b| b.name()).join("\\n")',
        ).splitlines()
        if head not in current:
            raise Error(
                f"local bookmark {head} changed while importing the live base; "
                "replan and retry"
            )


def boundary_commands(
    boundary: str,
    base_oid: str,
    remote: str,
    git_root: str,
    live_oid: str | None,
) -> list[list[str]]:
    local = jj_inspect(
        "bookmark",
        "list",
        f"exact:{json.dumps(boundary)}",
        "-T",
        'name ++ "\\n"',
    ).stdout.splitlines()
    commands = [
        atomic_push_command(
            git_root, remote, (RefUpdate(boundary, live_oid, base_oid),)
        )
    ]
    if local:
        commands.append(
            [*JJ, "bookmark", "set", "--allow-backwards", "-r", base_oid, boundary]
        )
    return commands


