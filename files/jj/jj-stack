def git_commit_change_id(git_root: str, oid: str) -> str:
    commit = command(
        ["git", "--no-replace-objects", "-C", git_root, "cat-file", "-p", oid]
    ).stdout
    headers = commit.partition("\n\n")[0]
    matches = [
        line.removeprefix("change-id ")
        for line in headers.splitlines()
        if line.startswith("change-id ")
    ]
    if len(matches) != 1:
        raise Error(f"commit {oid[:12]} does not have exactly one jj change ID")
    return matches[0]


def git_linear_segment(git_root: str, base: str, tip: str) -> tuple[str, ...]:
    result = command(
        [
            "git",
            "--no-replace-objects",
            "-C",
            git_root,
            "rev-list",
            "--reverse",
            "--ancestry-path",
            f"{base}..{tip}",
        ],
        check=False,
    )
    commits = result.stdout.splitlines()
    if result.returncode != 0 or not commits:
        raise Error(
            f"live GitHub suffix does not descend from expected base {base[:12]}"
        )
    previous = base
    for oid in commits:
        row = command(
            [
                "git",
                "--no-replace-objects",
                "-C",
                git_root,
                "rev-list",
                "--parents",
                "-n",
                "1",
                oid,
            ]
        ).stdout.split()
        if row != [oid, previous]:
            raise Error(
                "live GitHub suffix must be a complete linear chain without merges; "
                f"{oid[:12]} does not directly follow {previous[:12]}"
            )
        previous = oid
    if commits[-1] != tip:
        raise Error(f"could not validate live GitHub head {tip[:12]}")
    return tuple(commits)


def git_last_linear_commits(git_root: str, tip: str, count: int) -> tuple[str, ...]:
    commits = command(
        [
            "git",
            "--no-replace-objects",
            "-C",
            git_root,
            "rev-list",
            "--first-parent",
            f"--max-count={count}",
            tip,
        ]
    ).stdout.splitlines()
    if len(commits) != count:
        raise Error(f"tracked segment ending at {tip[:12]} is incomplete")
    commits.reverse()
    for oid in commits:
        parents = command(
            [
                "git",
                "--no-replace-objects",
                "-C",
                git_root,
                "rev-list",
                "--parents",
                "-n",
                "1",
                oid,
            ]
        ).stdout.split()
        if len(parents) != 2:
            raise Error(f"tracked segment contains merge commit {oid[:12]}")
    return tuple(commits)


def git_commit_parent(git_root: str, oid: str) -> str:
    row = command(
        [
            "git",
            "--no-replace-objects",
            "-C",
            git_root,
            "rev-list",
            "--parents",
            "-n",
            "1",
            oid,
        ]
    ).stdout.split()
    if len(row) != 2 or row[0] != oid:
        raise Error(f"live segment starts with non-linear commit {oid[:12]}")
    return row[1]


def git_patch_id(git_root: str, oid: str) -> str | None:
    patch = command(
        [
            "git",
            "--no-replace-objects",
            "-C",
            git_root,
            "show",
            "--pretty=format:",
            "--binary",
            "--no-ext-diff",
            "--no-textconv",
            oid,
        ]
    ).stdout
    result = command(["git", "patch-id", "--stable"], stdin_text=patch)
    fields = result.stdout.split()
    if not fields:
        return None
    if len(fields) != 2:
        raise Error(f"could not calculate stable patch ID for {oid[:12]}")
    return fields[0]


class RemoteCheck(Enum):
    EXACT = "live head matches tracked baseline"
    RESTACKED = "jj change IDs and stable patch IDs match"


@dataclass(frozen=True)
class ExistingBoundary:
    pr: PullRequest
    tracked_oid: str
    live_oid: str
    check: RemoteCheck


def validate_existing_suffix(
    stack: StackSnapshot,
    name_with_owner: str,
    tracked_refs: dict[str, str],
    live_refs: dict[str, str],
    git_root: str,
    remote: str,
) -> tuple[ExistingBoundary, ...]:
    if not stack.active:
        return ()
    first = stack.active[0]
    if first.base not in live_refs:
        raise Error(f"PR #{first.number} has no live base branch {first.base}")
    suffix_root = stack.merged[-1].head_oid if stack.merged else None
    if suffix_root is not None:
        ensure_git_commit(git_root, remote, suffix_root)
    previous_tracked = suffix_root
    previous_live = suffix_root
    previous_head = None
    result = []
    for pr in stack.active:
        first_open = previous_head is None
        if (
            pr.repository is None
            or pr.head_repository is None
            or pr.repository.lower() != name_with_owner.lower()
            or pr.head_repository.lower() != name_with_owner.lower()
        ):
            raise Error(
                f"PR #{pr.number} does not have a verified repository-local head"
            )
        if previous_head is not None and pr.base != previous_head:
            raise Error(f"PR #{pr.number} has base {pr.base}; expected {previous_head}")
        if previous_head is not None and pr.base_oid != previous_live:
            raise Error(
                f"PR #{pr.number} has an unexpected live base; GitHub restack is incoherent"
            )
        tracked_oid = tracked_refs.get(pr.head)
        live_oid = live_refs.get(pr.head)
        if tracked_oid is None:
            raise Error(f"PR #{pr.number} has no tracked restack baseline")
        if live_oid is None:
            raise Error(f"open PR #{pr.number} has no live branch {pr.head}")
        if live_oid != pr.head_oid:
            raise Error(
                f"PR #{pr.number} head does not match its live remote branch {pr.head}"
            )
        ensure_git_commit(git_root, remote, tracked_oid)
        ensure_git_commit(git_root, remote, live_oid)
        tracked_segment = (
            git_last_linear_commits(git_root, tracked_oid, pr.commits)
            if first_open
            else git_linear_segment(git_root, previous_tracked, tracked_oid)
        )
        live_segment = (
            git_last_linear_commits(git_root, live_oid, pr.commits)
            if first_open
            else git_linear_segment(git_root, previous_live, live_oid)
        )
        if len(tracked_segment) != pr.commits or len(live_segment) != pr.commits:
            raise Error(
                f"PR #{pr.number} tracked/live segment does not match its "
                f"reported {pr.commits} commits"
            )
        exact = tracked_oid == live_oid
        if not exact:
            for old_oid, new_oid in zip(tracked_segment, live_segment, strict=True):
                if git_commit_change_id(git_root, old_oid) != git_commit_change_id(
                    git_root, new_oid
                ) or git_patch_id(git_root, old_oid) != git_patch_id(git_root, new_oid):
                    raise Error(
                        f"PR #{pr.number} contains remote-only edits; the live suffix "
                        "is not a mechanical GitHub restack"
                    )
        result.append(
            ExistingBoundary(
                pr,
                tracked_oid,
                live_oid,
                RemoteCheck.EXACT if exact else RemoteCheck.RESTACKED,
            )
        )
        previous_tracked = tracked_oid
        previous_live = live_oid
        previous_head = pr.head
    return tuple(result)


def verify_existing_refs_unchanged(
    evidence: tuple[ExistingBoundary, ...], live_refs: dict[str, str]
) -> None:
    changed = [
        item.pr.head
        for item in evidence
        if live_refs.get(item.pr.head) != item.live_oid
    ]
    if changed:
        raise Error(
            "existing PR refs changed during reconciliation for "
            + ", ".join(changed)
            + "; replan and retry"
        )


def verify_live_suffix(
    states: tuple[BoundaryState, ...],
    base_oid: str,
    segment_commits: tuple[int, ...],
    git_root: str,
    remote: str,
    *,
    allow_restacked_first: bool = False,
) -> tuple[tuple[str, ...], ...]:
    if len(states) != len(segment_commits):
        raise Error("live GitHub evidence does not cover the complete open suffix")
    previous = base_oid
    segments = []
    for index, (state, expected_count) in enumerate(
        zip(states, segment_commits, strict=True)
    ):
        if state.pr.head != state.branch or state.pr.head_oid != state.live_oid:
            raise Error(
                f"PR #{state.pr.number} does not match live branch {state.branch}"
            )
        ensure_git_commit(git_root, remote, state.live_oid)
        if index == 0 and allow_restacked_first:
            try:
                segment = git_linear_segment(git_root, previous, state.live_oid)
            except Error:
                segment = git_last_linear_commits(
                    git_root, state.live_oid, expected_count
                )
                if git_commit_parent(git_root, segment[0]) != state.pr.base_oid:
                    raise Error(
                        f"PR #{state.pr.number} has an unexpected live base; "
                        "GitHub restack is incoherent"
                    )
        else:
            if state.pr.base_oid != previous:
                raise Error(
                    f"PR #{state.pr.number} has an unexpected live base; "
                    "GitHub restack is incoherent"
                )
            segment = git_linear_segment(git_root, previous, state.live_oid)
        if len(segment) != expected_count:
            raise Error(
                f"PR #{state.pr.number} contains {len(segment)} live commits; "
                f"expected {expected_count}"
            )
        segments.append(segment)
        previous = state.live_oid
    return tuple(segments)


def verify_mechanical_restack(
    states: tuple[BoundaryState, ...],
    base_oid: str,
    segment_commits: tuple[int, ...],
    git_root: str,
    remote: str,
    *,
    allow_restacked_first: bool = False,
) -> None:
    segments = verify_live_suffix(
        states,
        base_oid,
        segment_commits,
        git_root,
        remote,
        allow_restacked_first=allow_restacked_first,
    )
    for state, expected_count, segment in zip(
        states, segment_commits, segments, strict=True
    ):
        if state.tracked_oid is None:
            raise Error(f"PR #{state.pr.number} has no tracked restack baseline")
        tracked = git_last_linear_commits(git_root, state.tracked_oid, expected_count)
        for old_oid, new_oid in zip(tracked, segment, strict=True):
            if git_commit_change_id(git_root, old_oid) != git_commit_change_id(
                git_root, new_oid
            ) or git_patch_id(git_root, old_oid) != git_patch_id(git_root, new_oid):
                raise Error(
                    f"PR #{state.pr.number} contains remote-only edits; "
                    "the live suffix is not a mechanical GitHub restack"
                )


def verify_reconciliation_suffix(
    kind: ReconciliationKind,
    states: tuple[BoundaryState, ...],
    base_oid: str,
    desired_counts: tuple[int, ...],
    git_root: str,
    remote: str,
    *,
    allow_restacked_first: bool = False,
) -> None:
    if kind is ReconciliationKind.LOCAL_AUTHORITY:
        live_counts = tuple(state.pr.commits for state in states)
        if any(state.live_oid != state.tracked_oid for state in states):
            verify_mechanical_restack(
                states,
                base_oid,
                live_counts,
                git_root,
                remote,
                allow_restacked_first=allow_restacked_first,
            )
        else:
            verify_live_suffix(
                states,
                base_oid,
                live_counts,
                git_root,
                remote,
                allow_restacked_first=allow_restacked_first,
            )
    elif kind is ReconciliationKind.REMOTE_ADOPT:
        verify_mechanical_restack(
            states,
            base_oid,
            desired_counts,
            git_root,
            remote,
            allow_restacked_first=allow_restacked_first,
        )
    elif kind is ReconciliationKind.ALREADY_CONVERGED:
        verify_live_suffix(
            states,
            base_oid,
            desired_counts,
            git_root,
            remote,
            allow_restacked_first=allow_restacked_first,
        )


def classify_reconciliation(
    states: tuple[BoundaryState, ...],
    *,
    has_new_boundaries: bool,
    topology_changed: bool = False,
) -> ReconciliationKind:
    if topology_changed:
        return (
            ReconciliationKind.LOCAL_AUTHORITY
            if any(state.local_oid != state.live_oid for state in states)
            else ReconciliationKind.NORMAL_PUBLISH
        )
    if not states:
        return ReconciliationKind.NORMAL_PUBLISH
    missing = [state.branch for state in states if state.tracked_oid is None]
    if missing:
        if has_new_boundaries or any(
            state.local_oid != state.live_oid for state in states
        ):
            raise Error(
                "no usable pre-fetch tracking baseline for "
                + ", ".join(missing)
                + "; only an already-synchronized fresh clone is safe"
            )
        return ReconciliationKind.ALREADY_CONVERGED
    if all(state.local_oid == state.live_oid for state in states):
        return (
            ReconciliationKind.NORMAL_PUBLISH
            if has_new_boundaries
            else ReconciliationKind.ALREADY_CONVERGED
        )
    if all(state.local_oid == state.tracked_oid for state in states):
        return ReconciliationKind.REMOTE_ADOPT
    return ReconciliationKind.LOCAL_AUTHORITY


def has_topology_delta(heads: list[str], stack: StackSnapshot) -> bool:
    selected_pr_ids = [
        stack.discovered[head].node_id for head in heads if head in stack.discovered
    ]
    selected_pr_id_set = set(selected_pr_ids)
    retained_old_ids = [
        pr.node_id for pr in stack.active if pr.node_id in selected_pr_id_set
    ]
    return (
        len(selected_pr_ids) != len(heads)
        or len(retained_old_ids) != len(stack.active)
        or selected_pr_ids != retained_old_ids
    )


def boundary_states(
    revisions: list[Revision],
    heads: list[str],
    stack: StackSnapshot,
    fetched: dict[str, str],
    live: dict[str, str],
) -> tuple[BoundaryState, ...]:
    result = []
    for revision, head in zip(revisions, heads, strict=True):
        pr = stack.discovered.get(head)
        if pr is None:
            continue
        live_oid = live.get(head)
        if live_oid is None:
            raise Error(f"open PR #{pr.number} has no live branch {head}")
        result.append(
            BoundaryState(head, revision.commit_id, fetched.get(head), live_oid, pr)
        )
    return tuple(result)


def verify_live_boundary_refs_unchanged(
    states: tuple[BoundaryState, ...], live: dict[str, str]
) -> None:
    changed = [
        state.branch for state in states if live.get(state.branch) != state.live_oid
    ]
    if changed:
        raise Error(
            "live PR refs changed after authority classification for "
            + ", ".join(changed)
            + "; replan and retry"
        )


def local_bookmark_oid(name: str) -> str | None:
    result = jj_inspect(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        f"bookmarks(exact:{json.dumps(name)})",
        "-T",
        'commit_id ++ "\\n"',
        check=False,
    )
    values = result.stdout.splitlines()
    if result.returncode != 0:
        raise Error(
            f"could not inspect the local bookmark target for open PR branch {name}"
        )
    if not values:
        return None
    if len(values) != 1:
        raise Error(f"open PR branch {name} has ambiguous local bookmark targets")
    return values[0]


def atomic_push_command(
    git_root: str, remote: str, updates: tuple[RefUpdate, ...], *, dry_run: bool = False
) -> list[str]:
    args = ["git", "-C", git_root, "push", remote, "--atomic"]
    if dry_run:
        args.extend(["--dry-run", "--no-verify"])
    for update in updates:
        expected = update.old_oid or ""
        ref = f"refs/heads/{update.branch}"
        args.append(f"--force-with-lease={ref}:{expected}")
    for update in updates:
        ref = f"refs/heads/{update.branch}"
        args.append(f"{update.new_oid}:{ref}")
    return args


def make_ref_publication_plan(
    kind: ReconciliationKind,
    revisions: list[Revision],
    heads: list[str],
    live: dict[str, str],
) -> RefPublicationPlan:
    if kind in {ReconciliationKind.REMOTE_ADOPT, ReconciliationKind.ALREADY_CONVERGED}:
        return RefPublicationPlan(kind, ())
    updates = tuple(
        RefUpdate(head, live.get(head), revision.commit_id)
        for revision, head in zip(revisions, heads, strict=True)
        if live.get(head) != revision.commit_id
    )
    return RefPublicationPlan(kind, updates)


def workspace_targets() -> tuple[tuple[str, str], ...]:
    rows = jj_output(
        "workspace", "list", "-T", 'name ++ "\\t" ++ target.commit_id() ++ "\\n"'
    ).splitlines()
    return tuple(tuple(row.split("\t", 1)) for row in rows)  # type: ignore[return-value]


def visible_identities() -> frozenset[tuple[str, str]]:
    rows = jj_output(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        "all()",
        "-T",
        'change_id ++ "\\t" ++ commit_id ++ "\\n"',
    ).splitlines()
    return frozenset(tuple(row.split("\t", 1)) for row in rows)  # type: ignore[arg-type]


def local_bookmark_targets() -> tuple[tuple[str, str], ...]:
    rows = jj_output(
        "log",
        "--color=never",
        "--no-graph",
        "-r",
        "bookmarks()",
        "-T",
        'local_bookmarks.map(|b| b.name() ++ "\\t" ++ commit_id ++ "\\n").join("")',
    ).splitlines()
    return tuple(sorted(tuple(row.split("\t", 1)) for row in rows))  # type: ignore[arg-type]


def capture_closure(root: str) -> ClosureSnapshot:
    commits = tuple(revision_ids(f"{root}::"))
    if not commits or commits[0] != root:
        raise Error("could not capture the complete local descendant closure")
    change_ids = tuple(change_id_at(oid) for oid in commits)
    if len(set(change_ids)) != len(change_ids):
        raise Error("local descendant closure contains divergent jj changes")
    return ClosureSnapshot(
        root,
        commits,
        change_ids,
        visible_identities(),
        workspace_targets(),
        local_bookmark_targets(),
    )


def refresh_closure_baseline(before: ClosureSnapshot, base_oid: str) -> ClosureSnapshot:
    if any(not revision_ids(f"{oid} & visible()") for oid in before.commits):
        raise Error("selective base import changed the planned local closure")
    if revision_ids(base_oid) != [base_oid]:
        raise Error("selective base import did not import the live base commit")
    workspaces = workspace_targets()
    if workspaces != before.workspaces:
        raise Error("selective base import changed a workspace target")
    bookmarks = local_bookmark_targets()
    if bookmarks != before.bookmarks:
        raise Error("selective base import changed a local bookmark target")
    return ClosureSnapshot(
        before.root,
        before.commits,
        before.change_ids,
        visible_identities(),
        workspaces,
        bookmarks,
    )


def operation_id() -> str:
    values = command(
        [
            *JJ,
            "--at-op=@",
            "op",
            "log",
            "--no-graph",
            "-n",
            "1",
            "-T",
            'id ++ "\\n"',
        ]
    ).stdout.splitlines()
    if len(values) != 1:
        raise Error("could not capture the current jj operation")
    return values[0]


def begin_inspection_phase() -> str:
    global INSPECTION_OPERATION
    INSPECTION_OPERATION = operation_id()
    return INSPECTION_OPERATION


def current_oid_for_change(change_id: str) -> str:
    values = revision_ids(f"exactly({change_id}, 1)")
    if len(values) != 1:
        raise Error(f"could not resolve rewritten jj change {change_id[:12]}")
    return values[0]


def verify_rewritten_closure(
    before: ClosureSnapshot,
) -> dict[str, str]:
    rewritten = {
        change_id: current_oid_for_change(change_id) for change_id in before.change_ids
    }
    after_visible = visible_identities()
    changed_ids = {change_id for change_id, _oid in before.visible ^ after_visible}
    unexpected = changed_ids - set(before.change_ids)
    if unexpected:
        raise Error(
            "rebase unexpectedly rewrote changes outside the planned descendant closure: "
            + ", ".join(sorted(change_id[:12] for change_id in unexpected))
        )
    rewritten_set = "(" + " | ".join(rewritten.values()) + ")"
    if revision_ids(f"{rewritten_set} & conflicts()"):
        raise Error(
            "local reconciliation produced conflicts; resolve them before publishing"
        )
    for name, old_oid in before.workspaces:
        current = dict(workspace_targets()).get(name)
        old_change = change_id_at(old_oid)
        expected = rewritten.get(old_change, old_oid)
        if current != expected:
            raise Error(
                f"workspace {name} did not remain attached to its planned change"
            )
    expected_bookmarks = tuple(
        sorted(
            (name, rewritten.get(change_id_at(old_oid), old_oid))
            for name, old_oid in before.bookmarks
        )
    )
    if local_bookmark_targets() != expected_bookmarks:
        raise Error("rebase did not preserve the planned local bookmark mapping")
    return rewritten


def fetch_exact_branches(
    repo: Repository, remote: str, expected: dict[str, str]
) -> None:
    if not expected:
        return
    args = ["git", "fetch", "--remote", remote]
    for branch in expected:
        args.extend(["--branch", branch])
    jj(*args)
    fetched = fetched_remote_refs(repo.git_root, remote)
    changed = [name for name, oid in expected.items() if fetched.get(name) != oid]
    if changed:
        raise Error(
            "remote refs changed while importing "
            + ", ".join(changed)
            + "; replan and retry"
        )


def track_published_branches(remote: str, expected: dict[str, str]) -> None:
    if not expected:
        return
    local_targets: dict[str, set[str]] = {}
    for name, oid in local_bookmark_targets():
        local_targets.setdefault(name, set()).add(oid)
    divergent = [
        name
        for name, oid in expected.items()
        if name in local_targets and local_targets[name] != {oid}
    ]
    if divergent:
        raise Error(
            "publication completed, but local bookmarks diverged before remote "
            "tracking could be established for " + ", ".join(divergent)
        )
    result = jj(
        "bookmark",
        "track",
        *(f"{name}@{remote}" for name in expected),
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise Error(
            "publication completed, but jj remote-bookmark tracking could not be "
            "established" + (f":\n{detail}" if detail else "")
        )


def verify_published_branch_tracking(remote: str, expected: dict[str, str]) -> None:
    if not expected:
        return
    names = set(expected)
    tracked = set(
        filter(
            None,
            jj_output(
                "bookmark",
                "list",
                "--tracked",
                "--remote",
                f"exact:{remote}",
                "-T",
                'if(remote, name ++ "\\n")',
                *(f"exact:{name}" for name in expected),
            ).splitlines(),
        )
    )
    local_targets: dict[str, set[str]] = {}
    for name, oid in local_bookmark_targets():
        if name in names:
            local_targets.setdefault(name, set()).add(oid)
    invalid = [
        name
        for name, oid in expected.items()
        if name not in tracked or local_targets.get(name) != {oid}
    ]
    if invalid:
        raise Error(
            "publication completed, but canonical bookmarks are not locally tracked "
            "at the published revisions: " + ", ".join(invalid)
        )


class TopologyKind(Enum):
    NEW = "new stack"
    METADATA_ONLY = "metadata/update only"
    APPEND = "append"
    FULLY_OPEN_REBUILD = "fully open insertion/reorder"
    MERGED_PREFIX_REBUILD = "merged-prefix insertion/reorder"


@dataclass(frozen=True)
class Plan:
    kind: TopologyKind
    heads: list[str]
    omitted: list[PullRequest]
    link_heads: list[str]
    stack_number: int | None
    boundary: PullRequest | None
    refresh_base: bool
    segment_commits: tuple[int, ...] = ()


def verify_unstackable(plan: Plan, stack: StackSnapshot) -> None:
    disappearing = (
        stack.active
        if plan.kind
        in {
            TopologyKind.FULLY_OPEN_REBUILD,
            TopologyKind.MERGED_PREFIX_REBUILD,
        }
        else plan.omitted
    )
    blocked = [pr for pr in disappearing if pr.auto_merge or pr.merge_queue]
    if blocked:
        raise Error(
            "PRs that will be unstacked must leave auto-merge or merge queue first: "
            + ", ".join(f"#{pr.number}" for pr in blocked)
        )


def make_plan(
    revisions: list[Revision],
    heads: list[str],
    stack: StackSnapshot,
    base_oid: str,
    segment_commits: tuple[int, ...] = (),
) -> Plan:
    existing = [pr.head for pr in stack.active]
    selected = set(heads)
    omitted = [pr for pr in stack.active if pr.head not in selected]
    needs_boundary_refresh = bool(
        stack.merged
        and stack.active
        and stack.active[0].base == stack.merged[-1].head
        and stack.active[0].base_oid != base_oid
    )
    if not heads:
        kind = (
            TopologyKind.MERGED_PREFIX_REBUILD
            if stack.active or stack.closed
            else TopologyKind.METADATA_ONLY
        )
        link_heads = []
    elif stack.closed:
        kind = (
            TopologyKind.MERGED_PREFIX_REBUILD
            if stack.merged
            else TopologyKind.FULLY_OPEN_REBUILD
        )
        link_heads = heads
    elif stack.number is None:
        kind = TopologyKind.NEW
        link_heads = heads
    elif needs_boundary_refresh:
        # GitHub does not allow changing the base of a PR while it belongs to a
        # stack. Rebuild the open suffix so the first PR can be refreshed after
        # the merged boundary moves, then relink every selected head.
        kind = TopologyKind.MERGED_PREFIX_REBUILD
        link_heads = heads
    elif existing == heads:
        kind = TopologyKind.METADATA_ONLY
        link_heads = []
    elif not omitted and existing == heads[: len(existing)]:
        kind = TopologyKind.APPEND
        link_heads = heads[len(existing) :]
    elif stack.merged:
        kind = TopologyKind.MERGED_PREFIX_REBUILD
        link_heads = heads
    else:
        kind = TopologyKind.FULLY_OPEN_REBUILD
        link_heads = heads
    boundary = (
        stack.merged[-1]
        if heads
        and (
            kind is TopologyKind.MERGED_PREFIX_REBUILD
            or (kind is TopologyKind.APPEND and not stack.active and stack.merged)
            or needs_boundary_refresh
        )
        else None
    )
    first_pr = stack.discovered.get(heads[0]) if heads else None
    refresh_base = (
        boundary is not None and first_pr is not None and first_pr.base_oid != base_oid
    )
    return Plan(
        kind,
        heads,
        omitted,
        link_heads,
        stack.number,
        boundary,
        refresh_base,
        segment_commits,
    )


def segment_counts(selection: Selection) -> tuple[int, ...]:
    positions = {commit_id: index for index, commit_id in enumerate(selection.commits)}
    counts = []
    previous = -1
    for boundary in selection.boundaries:
        current = positions[boundary]
        counts.append(current - previous)
        previous = current
    return tuple(counts)


def expected_first_open_base(plan: Plan, stack: StackSnapshot, base: str) -> str:
    if plan.kind in {TopologyKind.NEW, TopologyKind.FULLY_OPEN_REBUILD}:
        return base
    if plan.boundary and (
        not stack.active or plan.kind is TopologyKind.MERGED_PREFIX_REBUILD
    ):
        return plan.boundary.head
    if stack.active:
        return stack.active[0].base
    return base


def terminal_text(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)[1:-1]


def validate_close_targets(plan: Plan, close_numbers: frozenset[int]) -> None:
    omitted = {pr.number for pr in plan.omitted}
    invalid = sorted(close_numbers - omitted)
    if invalid:
        rendered = ", ".join(f"#{number}" for number in invalid)
        raise Error(
            f"--close-omitted target is not an omitted open PR in this plan: {rendered}"
        )


def print_plan(
    plan: Plan,
    revisions: list[Revision],
    stack: StackSnapshot,
    repo: Repository,
    remote: str,
    selection: Selection | None,
    base_oid: str,
    selectors: dict[str, tuple[PullRequest, ...]],
    *,
    reconciliation: ReconciliationKind = ReconciliationKind.NORMAL_PUBLISH,
    states: tuple[BoundaryState, ...] = (),
    closure: ClosureSnapshot | None = None,
    recovery: RecoveryEvidence | None = None,
    verbosity: int = 0,
    existing_evidence: tuple[ExistingBoundary, ...] = (),
    close_numbers: frozenset[int] = frozenset(),
) -> None:
    existing = sum(head in stack.discovered for head in plan.heads)
    created = len(plan.heads) - existing
    if reconciliation is ReconciliationKind.ALREADY_CONVERGED and not plan.omitted:
        title = f"stack #{stack.number} is already converged"
    elif recovery is not None:
        title = (
            f"attach {len(plan.heads)} existing PR(s) to surviving "
            f"stack #{stack.number}"
        )
    elif plan.kind is TopologyKind.NEW:
        title = f"create a stack with {len(plan.heads)} PR(s)"
    elif plan.kind is TopologyKind.APPEND:
        title = f"append {len(plan.link_heads)} PR(s) to stack #{stack.number}"
    elif plan.kind is TopologyKind.METADATA_ONLY:
        title = f"update stack #{stack.number}"
    else:
        title = f"rebuild the open suffix of stack #{stack.number}"
    print(f"Plan: {title}", file=sys.stderr)

    if closure is not None:
        workspaces = len(closure.workspaces)
        print(
            f"  Local: rebase a {len(closure.commits)}-commit descendant closure "
            f"onto {remote}/{repo.base}; {workspaces} workspace(s) follow.",
            file=sys.stderr,
        )
    elif reconciliation is ReconciliationKind.REMOTE_ADOPT:
        print(
            "  Local: import the mechanically verified GitHub restack.", file=sys.stderr
        )
    elif reconciliation is ReconciliationKind.ALREADY_CONVERGED:
        print("  Local: no history changes.", file=sys.stderr)
    else:
        print("  Local: preserve the selected history.", file=sys.stderr)

    publication = []
    if plan.heads and reconciliation not in {
        ReconciliationKind.ALREADY_CONVERGED,
        ReconciliationKind.REMOTE_ADOPT,
    }:
        publication.append(f"publish {len(plan.heads)} canonical branch(es)")
    if plan.boundary:
        publication.append(
            f"advance merged boundary {plan.boundary.head} to {repo.base}"
        )
    print(
        "  Remote: "
        + ("; ".join(publication) + "." if publication else "no ref changes."),
        file=sys.stderr,
    )
    github = [f"reuse {existing} PR(s)", f"create {created} draft PR(s)"]
    if plan.kind in {
        TopologyKind.FULLY_OPEN_REBUILD,
        TopologyKind.MERGED_PREFIX_REBUILD,
    }:
        github.append("unstack and relink the open suffix")
    elif recovery is not None:
        github.append(f"link them after merged PR #{recovery.boundary.number}")
    if plan.omitted:
        detached = ", ".join(f"#{pr.number}" for pr in plan.omitted)
        github.append(f"detach {detached}")
    if close_numbers:
        github.append(
            "close " + ", ".join(f"#{number}" for number in sorted(close_numbers))
        )
    print("  GitHub: " + "; ".join(github) + ".", file=sys.stderr)
    if recovery is not None:
        print(
            "  History identifies this as the unique surviving stack consistent "
            "with the selected PRs; GitHub does not retain former stack membership.",
            file=sys.stderr,
        )
    elif plan.kind is TopologyKind.NEW and stack.discovered:
        print(
            "  No surviving stack was identified; any former stack number is unavailable.",
            file=sys.stderr,
        )

    if verbosity < 1:
        return
    print(f"Evidence: {reconciliation.value}", file=sys.stderr)
    if selection is not None:
        print(
            f"  base {repo.base}={base_oid[:12]}; fork={selection.fork[:12]}; "
            f"segments={','.join(map(str, plan.segment_commits))}",
            file=sys.stderr,
        )
    for state in states:
        tracked = state.tracked_oid[:12] if state.tracked_oid else "missing"
        print(
            f"  {state.branch}: local={state.local_oid[:12]} "
            f"tracked={tracked} remote={state.live_oid[:12]}",
            file=sys.stderr,
        )
    if recovery is not None:
        event = recovery.transition
        print(
            f"  PR base event {event.node_id}: {event.previous} → {event.current} "
            f"at {event.created_at}",
            file=sys.stderr,
        )
    for oid, matches in selectors.items():
        prs = ", ".join(f"#{pr.number}" for pr in matches)
        print(f"  merged selector {oid[:12]}: {prs}", file=sys.stderr)
    for index, (revision, head) in enumerate(
        zip(revisions, plan.heads, strict=True), 1
    ):
        pr = stack.discovered.get(head)
        identity = f"reuse PR #{pr.number}" if pr else "create draft PR"
        readiness = "unchanged" if pr else "draft"
        commits = plan.segment_commits[index - 1]
        if pr and commits > 1:
            metadata = "preserve existing title/body; review after multi-commit content changes"
        elif pr and pr.commits > 1:
            metadata = (
                f"sync title/body; segment changed {pr.commits} → {commits} commits, "
                "so local title/body becomes authoritative"
            )
        else:
            metadata = "sync title/body"
        print(
            f"  {index}. {head}: {identity}; readiness {readiness}; "
            f"{commits} commit(s); {metadata}",
            file=sys.stderr,
        )
    if plan.omitted:
        evidence = {item.pr.node_id: item for item in existing_evidence}
        noun = "this open PR" if len(plan.omitted) == 1 else "these open PRs"
        print(f"  desired stack omits {noun}:", file=sys.stderr)
        for pr in plan.omitted:
            item = evidence.get(pr.node_id)
            print(
                f"    #{pr.number} {terminal_text(pr.title)}\n"
                f"      {pr.url}\n"
                "      action: detach from stack; "
                + (
                    "close after successful publication"
                    if pr.number in close_numbers
                    else "leave open"
                ),
                file=sys.stderr,
            )
            if item is not None:
                print(
                    f"      branch: retain {pr.head} @ {item.live_oid[:8]}",
                    file=sys.stderr,
                )
                if item.check is RemoteCheck.EXACT:
                    check = item.check.value
                else:
                    check = (
                        f"restacked since tracked {item.tracked_oid[:8]}; "
                        f"{item.check.value}"
                    )
                print(f"      remote check: {check}", file=sys.stderr)
        print(
            "  omission checks compare each PR with its tracked remote baseline; "
            "they do not prove its changes are present in the desired stack",
            file=sys.stderr,
        )


def requires_confirmation(
    plan: Plan,
    stack: StackSnapshot,
    reconciliation: ReconciliationKind,
    recovery: RecoveryEvidence | None,
) -> bool:
    return bool(
        reconciliation is ReconciliationKind.LOCAL_AUTHORITY
        or plan.boundary
        or plan.kind
        in {
            TopologyKind.FULLY_OPEN_REBUILD,
            TopologyKind.MERGED_PREFIX_REBUILD,
        }
        or plan.omitted
        or recovery is not None
        or (plan.kind is TopologyKind.NEW and stack.discovered)
    )


def authorize_plan(*, required: bool, plan_only: bool, yes: bool) -> None:
    if not required or plan_only or yes:
        return
    if not sys.stdin.isatty():
        raise Error("this plan requires confirmation; rerun with --yes")
    print(file=sys.stderr)
    print("Continue? [y/N] ", end="", file=sys.stderr, flush=True)
    try:
        answer = input()
    except EOFError:
        answer = ""
    if answer.strip().lower() not in {"y", "yes"}:
        raise Error("publication cancelled")


def gh_plan(repo: Repository, args: list[str]) -> str:
    return f"(cd {shlex.quote(repo.git_root)} && GH_REPO={shlex.quote(repo.gh_repo)} {shlex.join(args)})"


def verify_unstacked(
    stack: StackSnapshot,
    name_with_owner: str,
    gh_env: dict[str, str],
    git_root: str,
) -> None:
    if stack.merged:
        if stack.node_id is None:
            raise Error("existing stack has no GraphQL node ID")
        remaining = fetch_stack(stack.node_id, gh_env, git_root)
        if [pr.node_id for pr in remaining.entries] == [
            pr.node_id for pr in stack.merged
        ]:
            return
        found = ", ".join(f"#{pr.number}" for pr in remaining.entries) or "none"
        raise Error(f"stack was only partially unstacked; remaining entries: {found}")

    if stack.number is None:
        raise Error("existing stack has no stack number")
    response = command(
        [
            "gh",
            "api",
            "--include",
            f"repos/{name_with_owner}/stacks/{stack.number}",
        ],
        cwd=git_root,
        env=gh_env,
        check=False,
    )
    first_line = response.stdout.splitlines()[0] if response.stdout else ""
    match = re.match(r"HTTP/\S+ (\d{3})\b", first_line)
    status = int(match.group(1)) if match else None
    if status == 404:
        return
    if status == 200:
        raise Error(f"stack {stack.number} still exists after unstacking")
    raise Error(
        f"could not verify whether stack {stack.number} was dissolved; "
        "stop and inspect it before rerunning"
    )


def link_command(
    plan: Plan, stack: StackSnapshot, repo: Repository, remote: str
) -> list[str] | None:
    if not plan.link_heads:
        return None
    args = ["gh", "stack", "link", "--remote", remote]
    if plan.kind in {TopologyKind.NEW, TopologyKind.FULLY_OPEN_REBUILD}:
        args.extend(["--base", repo.base])
    elif plan.stack_number is not None:
        args.append(str(plan.stack_number))
    args.extend(
        [
            "--",
            *[
                stack.discovered[head].url if head in stack.discovered else head
                for head in plan.link_heads
            ],
        ]
    )
    return args


def run_stack_link(
    args: list[str],
    git_root: str,
    gh_env: dict[str, str],
    temporary_heads: dict[str, str],
) -> subprocess.CompletedProcess[str]:
    originals: dict[str, str | None] = {}
    changed: list[str] = []
    try:
        for branch, oid in temporary_heads.items():
            ref = f"refs/heads/{branch}"
            current = command(
                ["git", "-C", git_root, "rev-parse", "--verify", ref],
                check=False,
            )
            old_oid = current.stdout.strip() if current.returncode == 0 else None
            originals[branch] = old_oid
            if old_oid == oid:
                continue
            command(
                [
                    "git",
                    "-C",
                    git_root,
                    "update-ref",
                    ref,
                    oid,
                    old_oid or "0" * 40,
                ]
            )
            changed.append(branch)
        return command(args, cwd=git_root, env=gh_env, check=False)
    finally:
        for branch in reversed(changed):
            ref = f"refs/heads/{branch}"
            old_oid = originals[branch]
            if old_oid is None:
                command(
                    [
                        "git",
                        "-C",
                        git_root,
                        "update-ref",
                        "-d",
                        ref,
                        temporary_heads[branch],
                    ]
                )
            else:
                command(
                    [
                        "git",
                        "-C",
                        git_root,
                        "update-ref",
                        ref,
                        old_oid,
                        temporary_heads[branch],
                    ]
                )


def synchronize_pull_requests(
    heads: list[str],
    prs: dict[str, PullRequest],
    metadata: dict[str, tuple[str, str]],
    gh_env: dict[str, str],
    git_root: str,
) -> None:
    declarations = []
    selections = []
    variables: dict[str, object] = {}
    for index, head in enumerate(heads):
        pr = prs[head]
        title, body = metadata[head]
        if (title, body) != (pr.title, pr.body):
            key = f"edit{index}"
            declarations.append(f"${key}: UpdatePullRequestInput!")
            variables[key] = {
                "pullRequestId": pr.node_id,
                "title": title,
                "body": body,
            }
            selections.append(
                f"{key}: updatePullRequest(input: ${key}) {{ pullRequest {{ url }} }}"
            )
    if selections:
        graphql(
            f"mutation({', '.join(declarations)}) {{ {' '.join(selections)} }}",
            variables,
            gh_env,
            git_root,
            "stack was updated, but synchronizing pull request metadata failed; some updates may have succeeded",
        )


def fetch_pull_request(
    node_id: str, gh_env: dict[str, str], git_root: str
) -> PullRequest:
    query = f"""query($id: ID!) {{
      node(id: $id) {{
        ... on PullRequest {{ {_PR_FIELDS} }}
      }}
    }}"""
    data = graphql(
        query,
        {"id": node_id},
        gh_env,
        git_root,
        "could not revalidate omitted pull request",
    )
    node = data.get("node")
    if node is None:
        raise Error("omitted pull request no longer exists")
    return parse_pr(node)


def verify_detached_omissions(
    evidence: tuple[ExistingBoundary, ...],
    repo: Repository,
    remote: str,
    gh_env: dict[str, str],
) -> dict[int, PullRequest]:
    live = remote_refs(repo.git_root, remote)
    verify_existing_refs_unchanged(evidence, live)
    result = {}
    for item in evidence:
        before = item.pr
        current = fetch_pull_request(before.node_id, gh_env, repo.git_root)
        if (
            current.node_id != before.node_id
            or current.number != before.number
            or current.repository != before.repository
            or current.head_repository != before.head_repository
            or current.head != before.head
            or current.head_oid != item.live_oid
        ):
            raise Error(
                f"omitted PR #{before.number} identity or branch changed after publication"
            )
        if current.state != "OPEN":
            raise Error(f"omitted PR #{before.number} is no longer open")
        if current.stack_id is not None:
            raise Error(f"omitted PR #{before.number} is still attached to a stack")
        if current.auto_merge or current.merge_queue:
            raise Error(
                f"omitted PR #{before.number} entered auto-merge or merge queue"
            )
        result[current.number] = current
    return result


def close_omitted_pull_request(
    pr: PullRequest, gh_env: dict[str, str], git_root: str
) -> None:
    graphql(
        """mutation($input: ClosePullRequestInput!) {
          closePullRequest(input: $input) { pullRequest { id state } }
        }""",
        {"input": {"pullRequestId": pr.node_id}},
        gh_env,
        git_root,
        f"could not close omitted PR #{pr.number}",
    )
    closed = fetch_pull_request(pr.node_id, gh_env, git_root)
    if (
        closed.state != "CLOSED"
        or closed.head != pr.head
        or closed.head_oid != pr.head_oid
        or closed.stack_id is not None
    ):
        raise Error(f"could not verify closure of omitted PR #{pr.number}")


def verify_final(
    repo: Repository,
    revisions: list[Revision],
    heads: list[str],
    metadata: dict[str, tuple[str, str]],
    expected_drafts: dict[str, bool],
    expected_first_base: str,
    inherited: list[PullRequest],
    expected_stack_id: str | None,
    base_oid: str,
    segment_commits: tuple[int, ...],
    gh_env: dict[str, str],
) -> StackSnapshot:
    if not heads:
        if expected_stack_id is None:
            raise Error(
                "cannot verify an empty open suffix without an identified stack"
            )
        final = fetch_stack(expected_stack_id, gh_env, repo.git_root)
        if [pr.node_id for pr in final.merged] != [pr.node_id for pr in inherited]:
            raise Error("final merged prefix differs from the inherited merged prefix")
        if final.active:
            raise Error("final stack still contains open pull requests")
        return final
    discovered = discover_pull_requests(
        repo.name_with_owner, heads, gh_env, repo.git_root
    )
    if set(discovered) != set(heads):
        missing = [head for head in heads if head not in discovered]
        raise Error(
            "publication completed partially; missing PRs for: " + ", ".join(missing)
        )
    stack_ids = {pr.stack_id for pr in discovered.values()}
    if None in stack_ids or len(stack_ids) != 1:
        raise Error(
            "publication completed partially; selected PRs are not together in one stack"
        )
    final = fetch_stack(stack_ids.pop(), gh_env, repo.git_root)
    if expected_stack_id is not None and final.node_id != expected_stack_id:
        raise Error(
            "publication moved the immutable merged prefix to a different stack"
        )
    if [pr.node_id for pr in final.merged] != [pr.node_id for pr in inherited]:
        raise Error("final merged prefix differs from the inherited merged prefix")
    if [pr.head for pr in final.active] != heads:
        raise Error("final open stack order does not match the selected revset")
    expected_base = base_oid
    for index, (revision, pr) in enumerate(zip(revisions, final.active, strict=True)):
        expected_base_name = expected_first_base if index == 0 else heads[index - 1]
        if (pr.title, pr.body) != metadata[pr.head]:
            raise Error(f"PR #{pr.number} metadata does not match the publication plan")
        if pr.draft != expected_drafts[pr.head]:
            state = "draft" if expected_drafts[pr.head] else "ready"
            raise Error(f"PR #{pr.number} is not {state} as planned")
        if pr.head_oid != revision.commit_id or pr.base_oid != expected_base:
            raise Error(
                f"PR #{pr.number} has unexpected head/base OID; expected "
                f"{revision.commit_id[:12]}/{expected_base[:12]}"
            )
        if pr.base != expected_base_name:
            raise Error(
                f"PR #{pr.number} has base {pr.base}, expected {expected_base_name}"
            )
        if pr.commits != segment_commits[index]:
            raise Error(
                f"PR #{pr.number} contains {pr.commits} commits; "
                f"expected {segment_commits[index]}"
            )
        expected_base = revision.commit_id
    return final


@dataclass(frozen=True)
class Discovery:
    selection: Selection | None
    range_revisions: list[Revision]
    revisions: list[Revision]
    heads: list[str]
    stack: StackSnapshot
    candidate_names: list[str]


def validate_head_ref_collisions(
    revisions: list[Revision],
    heads: list[str],
    selected_prs: dict[str, PullRequest],
    live_refs: dict[str, str],
    base: str,
) -> None:
    for revision, head in zip(revisions, heads, strict=True):
        if head == base:
            raise Error(f"selected PR head collides with the base branch: {head}")
        live_oid = live_refs.get(head)
        if (
            head not in selected_prs
            and live_oid is not None
            and live_oid != revision.commit_id
        ):
            raise Error(
                f"selected PR head collides with an unrelated remote branch: {head}"
            )


def verify_selected_pr_change_identity(
    revisions: list[Revision],
    heads: list[str],
    selected_prs: dict[str, PullRequest],
    tracked_refs: dict[str, str],
) -> None:
    for revision, head in zip(revisions, heads, strict=True):
        pr = selected_prs.get(head)
        if pr is None:
            continue
        tracked_oid = tracked_refs.get(head)
        if tracked_oid is None:
            matches = revision.commit_id == pr.head_oid
            old_change = "unavailable"
        else:
            old_change = change_id_at(tracked_oid)
            matches = old_change == revision.change_id
        if not matches:
            raise Error(
                f"bookmark {head} is the head of PR #{pr.number}, but moved from "
                f"change {old_change[:12]} to change {revision.change_id[:12]}\n\n"
                "Reusing an existing PR for a different jj change is not currently supported."
            )


def publication_identity(
    discovery: Discovery,
) -> tuple[tuple[str, str, str | None], ...]:
    return tuple(
        (
            revision.change_id,
            head,
            discovery.stack.discovered[head].node_id
            if head in discovery.stack.discovered
            else None,
        )
        for revision, head in zip(discovery.revisions, discovery.heads, strict=True)
    )


def verify_planned_head_refs_unchanged(
    planned: dict[str, str | None], current: dict[str, str]
) -> None:
    changed = [name for name, oid in planned.items() if current.get(name) != oid]
    if changed:
        raise Error(
            "selected remote refs changed during reconciliation for "
            + ", ".join(changed)
            + "; replan and retry"
        )


def expand_open_suffix(open_oids: list[str], discovered: Discovery) -> list[str]:
    if not open_oids:
        return open_oids
    selected_range = {revision.commit_id for revision in discovered.range_revisions}
    selected_heads = set(discovered.heads)
    missing_prs = [
        pr for pr in discovered.stack.active if pr.head not in selected_heads
    ]
    if not missing_prs:
        return open_oids
    expandable = []
    for pr in missing_prs:
        oid = local_bookmark_oid(pr.head)
        if oid is not None and oid in selected_range:
            expandable.append(oid)
    if not expandable:
        return open_oids
    return revision_ids("(" + " | ".join([*open_oids, *expandable]) + ")")


def discover_publication(
    open_oids: list[str],
    base_oid: str,
    repo: Repository,
    remote: str,
    gh_env: dict[str, str],
    identified_stack: StackSnapshot | None,
    *,
    reject_divergence: bool,
) -> Discovery:
    selection = (
        validate_boundaries(
            open_oids,
            base_oid,
            repo.git_root,
            remote,
            reject_divergence=reject_divergence,
        )
        if open_oids
        else None
    )
    range_revisions = (
        revision_details(list(selection.commits), remote, set(selection.boundaries))
        if selection
        else []
    )
    candidate_names = sorted(
        {
            name
            for revision in range_revisions
            for name in (
                *revision.local_bookmarks,
                *revision.remote_bookmarks,
                revision.generated_bookmark,
            )
        }
    )
    discovered = discover_pull_requests(
        repo.name_with_owner, candidate_names, gh_env, repo.git_root
    )
    requested = set(selection.boundaries) if selection else set()
    # Existing PR boundaries inside a selected sparse range are part of the
    # managed suffix even when REVSET did not name them explicitly.
    boundary_ids = []
    for revision in range_revisions:
        names = {
            *revision.local_bookmarks,
            *revision.remote_bookmarks,
            revision.generated_bookmark,
        }
        if revision.commit_id in requested or names & set(discovered):
            boundary_ids.append(revision.commit_id)
    if selection and tuple(boundary_ids) != selection.boundaries:
        selection = validate_boundaries(
            boundary_ids,
            base_oid,
            repo.git_root,
            remote,
            reject_divergence=reject_divergence,
        )
    by_id = {revision.commit_id: revision for revision in range_revisions}
    revisions = [by_id[commit_id] for commit_id in boundary_ids]
    missing_titles = [
        revision.commit_id for revision in revisions if not revision.title
    ]
    if missing_titles:
        raise Error(f"revision {missing_titles[0]} has no description title")
    heads, stack = inspect_existing_stack(
        repo.name_with_owner,
        candidate_names,
        range_revisions,
        tuple(boundary_ids),
        gh_env,
        repo.git_root,
        identified_stack,
    )
    return Discovery(
        selection, range_revisions, revisions, heads, stack, candidate_names
    )


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="jj stack",
        allow_abbrev=False,
        description=(
            "Publish jj PR boundaries as the authoritative GitHub PR stack. "
            "Existing PRs are reused, missing PRs are created, and PR metadata, "
            "membership, and order are reconciled. Any merged prefix is retained."
        ),
        epilog=(
            "Stack push reasons about commit ancestry and jj change identity. It does not "
            "detect patch-equivalent changes already applied to the base through squash, "
            "cherry-pick, or independently authored commits."
        ),
    )
    commands = parser.add_subparsers(dest="command", required=True)
    push = commands.add_parser("push", allow_abbrev=False)
    push.add_argument(
        "--remote", help="Git remote to push (default: git.push, then origin)"
    )
    push.add_argument(
        "--base", help="trunk branch (default: repository default branch)"
    )
    push.add_argument(
        "--close-omitted",
        action="append",
        type=int,
        default=[],
        metavar="PR_NUMBER",
        help=(
            "detach and close this exact omitted PR after successful publication; "
            "repeat for multiple PRs"
        ),
    )
    execution = push.add_mutually_exclusive_group()
    execution.add_argument(
        "--plan",
        action="store_true",
        help=(
            "validate current inputs and describe planned actions without publishing; "
            "only missing Git objects may be downloaded locally"
        ),
    )
    execution.add_argument(
        "--yes",
        action="store_true",
        help="accept a consequential plan without an interactive prompt",
    )
    push.add_argument(
        "--create-separate-stack",
        action="store_true",
        help="do not recover a surviving historical stack for unstacked existing PRs",
    )
    push.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="show evidence; repeat once to also show commands and child output",
    )
    push.add_argument("revset")
    args = parser.parse_args(argv)
    if args.verbose > 2:
        parser.error("at most -vv is supported")
    return args


def main() -> None:
    global VERBOSITY
    args = parse_args()
    VERBOSITY = args.verbose
    # Pin every inspection to one operation. `--at-op` implies
    # `--ignore-working-copy` and avoids reconciling divergent operation heads.
    planned_operation = begin_inspection_phase()
    remote = push_remote(args.remote)
    repo = github_repository(remote, args.base)
    actual_refs = remote_refs(repo.git_root, remote)
    fetched_refs = fetched_remote_refs(repo.git_root, remote)
    base_oid = actual_refs.get(repo.base)
    if base_oid is None:
        raise Error(f"remote branch does not exist: {repo.base}")

    selected_oids = revision_ids(f"({args.revset})")
    if not selected_oids:
        raise Error("revset selects no PR boundaries")
    gh_env = os.environ.copy()
    gh_env.update(GH_REPO=repo.gh_repo, GH_HOST=repo.host)
    selectors = discover_merged_selectors(
        repo.name_with_owner, selected_oids, gh_env, repo.git_root
    )
    identified_stack = selector_stack(selectors, gh_env, repo.git_root)
    open_oids = [oid for oid in selected_oids if oid not in selectors]
    discovered = discover_publication(
        open_oids,
        base_oid,
        repo,
        remote,
        gh_env,
        identified_stack,
        reject_divergence=False,
    )
    expanded_oids = expand_open_suffix(open_oids, discovered)
    if expanded_oids != open_oids:
        discovered = discover_publication(
            expanded_oids,
            base_oid,
            repo,
            remote,
            gh_env,
            identified_stack,
            reject_divergence=False,
        )
    recovery_evidence = None
    selection = discovered.selection
    if selection is not None:
        open_oids = list(selection.boundaries)
        republished = set(selectors) & set(selection.commits)
        if republished:
            rendered = ", ".join(oid[:12] for oid in sorted(republished))
            raise Error(
                "merged selectors lie inside the publishable open range: "
                f"{rendered}; rebase or restack the open suffix onto {repo.base}"
            )
    revisions = discovered.revisions
    heads = discovered.heads
    stack = discovered.stack
    if (
        not args.create_separate_stack
        and identified_stack is None
        and stack.number is None
        and heads
        and len(stack.discovered) == len(heads)
    ):
        recovery = recover_surviving_stack(
            [stack.discovered[head] for head in heads], repo, gh_env
        )
        if recovery is not None:
            identified_stack, recovery_evidence = recovery
            discovered = discover_publication(
                open_oids,
                base_oid,
                repo,
                remote,
                gh_env,
                identified_stack,
                reject_divergence=False,
            )
            selection = discovered.selection
            revisions = discovered.revisions
            heads = discovered.heads
            stack = discovered.stack
    validate_head_ref_collisions(
        revisions, heads, stack.discovered, actual_refs, repo.base
    )
    verify_selected_pr_change_identity(revisions, heads, stack.discovered, fetched_refs)
    authorized_publication = publication_identity(discovered)
    planned_head_refs = {head: actual_refs.get(head) for head in heads}
    if (
        len(revisions) == 1
        and not selectors
        and not (stack.number is not None and heads[0] in stack.discovered)
    ):
        raise Error(
            "a single PR boundary is only valid when it already has an open PR in a stack"
        )
    counts = segment_counts(selection) if selection else ()
    states = boundary_states(revisions, heads, stack, fetched_refs, actual_refs)
    has_new_boundaries = len(states) != len(revisions)
    initial_plan = make_plan(revisions, heads, stack, base_oid, counts)
    topology_delta = has_topology_delta(heads, stack)
    existing_evidence = (
        validate_existing_suffix(
            stack,
            repo.name_with_owner,
            fetched_refs,
            actual_refs,
            repo.git_root,
            remote,
        )
        if topology_delta
        else ()
    )
    omitted_ids = {pr.node_id for pr in initial_plan.omitted}
    omitted_evidence = tuple(
        item for item in existing_evidence if item.pr.node_id in omitted_ids
    )
    reconciliation = classify_reconciliation(
        states,
        has_new_boundaries=has_new_boundaries,
        topology_changed=topology_delta,
    )
    if recovery_evidence is not None:
        verify_recovery_suffix(recovery_evidence, stack, states, counts, repo, remote)
    if not topology_delta:
        verify_reconciliation_suffix(
            reconciliation,
            states,
            open_suffix_root(stack, base_oid),
            counts,
            repo.git_root,
            remote,
            allow_restacked_first=bool(stack.merged),
        )
    if reconciliation is ReconciliationKind.LOCAL_AUTHORITY:
        imported_divergence = [
            state.branch
            for state in states
            if state.live_oid != state.local_oid
            and jj_commit_exists(state.live_oid)
            and revision_ids(f"{state.live_oid} & divergent()")
        ]
        if imported_divergence:
            raise Error(
                "GitHub restack variants were already imported and are ambiguous for "
                + ", ".join(imported_divergence)
                + "; inspect and resolve them explicitly"
            )

    close_numbers = frozenset(args.close_omitted)
    validate_close_targets(initial_plan, close_numbers)
    verify_unstackable(initial_plan, stack)
    closure = None
    if reconciliation is ReconciliationKind.LOCAL_AUTHORITY:
        if selection is None:
            raise Error("local reconciliation requires a nonempty open suffix")
        closure = capture_closure(selection.commits[0])
    print_plan(
        initial_plan,
        revisions,
        stack,
        repo,
        remote,
        selection,
        base_oid,
        selectors,
        reconciliation=reconciliation,
        states=states,
        closure=closure,
        recovery=recovery_evidence,
        verbosity=args.verbose,
        existing_evidence=existing_evidence,
        close_numbers=close_numbers,
    )
    authorize_plan(
        required=requires_confirmation(
            initial_plan, stack, reconciliation, recovery_evidence
        ),
        plan_only=args.plan,
        yes=args.yes,
    )

    if args.plan:
        if args.verbose >= 2:
            print("Commands:", file=sys.stderr)
        if reconciliation is ReconciliationKind.REMOTE_ADOPT:
            if args.verbose >= 2:
                print(
                    f"  {shlex.join([*JJ, 'git', 'fetch', '--remote', remote])}",
                    file=sys.stderr,
                )
        elif reconciliation is ReconciliationKind.LOCAL_AUTHORITY:
            assert closure is not None
            if args.verbose >= 2:
                print(
                    f"  {shlex.join([*JJ, 'git', 'fetch', '--remote', remote, '--branch', repo.base])}",
                    file=sys.stderr,
                )
                print(
                    f"  {shlex.join([*JJ, '--ignore-immutable', 'rebase', '-s', closure.root, '-o', base_oid])}",
                    file=sys.stderr,
                )
        else:
            ref_plan = make_ref_publication_plan(
                reconciliation, revisions, heads, actual_refs
            )
            if ref_plan.updates and args.verbose >= 2:
                print(
                    f"  {shlex.join(atomic_push_command(repo.git_root, remote, ref_plan.updates))}",
                    file=sys.stderr,
                )
        if initial_plan.boundary and args.verbose >= 2:
            for boundary_command in boundary_commands(
                initial_plan.boundary.head,
                base_oid,
                remote,
                repo.git_root,
                actual_refs.get(initial_plan.boundary.head),
            ):
                print(f"  {shlex.join(boundary_command)}", file=sys.stderr)
        if args.verbose >= 2 and initial_plan.kind in {
            TopologyKind.FULLY_OPEN_REBUILD,
            TopologyKind.MERGED_PREFIX_REBUILD,
        }:
            print(
                f"  {gh_plan(repo, ['gh', 'stack', 'unstack', str(initial_plan.stack_number)])}",
                file=sys.stderr,
            )
        if args.verbose >= 2 and (
            link := link_command(initial_plan, stack, repo, remote)
        ):
            print(f"  {gh_plan(repo, link)}", file=sys.stderr)
        if operation_id() != planned_operation:
            raise Error("jj operation changed during planning; replan and retry")
        print("No changes made.", file=sys.stderr)
        return

    if recovery_evidence is not None:
        current_recovery = recover_surviving_stack(
            [stack.discovered[head] for head in heads], repo, gh_env
        )
        if current_recovery is None or current_recovery[1] != recovery_evidence:
            raise Error("historical stack evidence changed after confirmation; replan")
    if operation_id() != planned_operation:
        raise Error("jj operation changed during planning; replan and retry")

    old_stack = stack
    old_states = states
    boundary_change_ids = [revision.change_id for revision in revisions]
    if operation_id() != planned_operation:
        raise Error("jj operation changed during planning; replan and retry")
    if reconciliation is ReconciliationKind.REMOTE_ADOPT:
        jj("git", "fetch", "--remote", remote)
        planned_operation = begin_inspection_phase()
        after_fetch = remote_refs(repo.git_root, remote)
        expected = {state.branch: state.live_oid for state in states}
        if after_fetch.get(repo.base) != base_oid or any(
            after_fetch.get(name) != oid for name, oid in expected.items()
        ):
            raise Error(
                "remote refs changed during adoption; inspect the fetched state and retry"
            )
        fetched_after = fetched_remote_refs(repo.git_root, remote)
        if any(fetched_after.get(name) != oid for name, oid in expected.items()):
            raise Error("jj fetch did not import the complete planned GitHub suffix")
        open_oids = [state.live_oid for state in states]
    elif reconciliation is ReconciliationKind.LOCAL_AUTHORITY:
        assert closure is not None
        fetch_exact_branches(repo, remote, {repo.base: base_oid})
        planned_operation = begin_inspection_phase()
        before_rebase = remote_refs(repo.git_root, remote)
        verify_existing_refs_unchanged(existing_evidence, before_rebase)
        if before_rebase.get(repo.base) != base_oid or any(
            before_rebase.get(state.branch) != state.live_oid for state in states
        ):
            raise Error("remote refs changed before local rebase; replan and retry")
        closure = refresh_closure_baseline(closure, base_oid)
        jj("--ignore-immutable", "rebase", "-s", closure.root, "-o", base_oid)
        planned_operation = begin_inspection_phase()
        rewritten = verify_rewritten_closure(closure)
        open_oids = [rewritten[change_id] for change_id in boundary_change_ids]

    fresh_stack = (
        fetch_stack(identified_stack.node_id, gh_env, repo.git_root)
        if identified_stack is not None and identified_stack.node_id is not None
        else None
    )
    discovered = discover_publication(
        open_oids,
        base_oid,
        repo,
        remote,
        gh_env,
        fresh_stack,
        reject_divergence=True,
    )
    selection = discovered.selection
    revisions = discovered.revisions
    heads = discovered.heads
    stack = discovered.stack
    if publication_identity(discovered) != authorized_publication:
        raise Error(
            "selected PR boundaries or identities changed during reconciliation; "
            "replan and retry"
        )
    counts = segment_counts(selection) if selection else ()
    verify_stack_snapshot_unchanged(old_stack, stack)
    plan = make_plan(revisions, heads, stack, base_oid, counts)
    if [pr.node_id for pr in plan.omitted] != [
        pr.node_id for pr in initial_plan.omitted
    ]:
        raise Error("omitted PR plan changed during reconciliation; replan and retry")
    validate_close_targets(plan, close_numbers)
    metadata = {
        head: (
            (stack.discovered[head].title, stack.discovered[head].body)
            if head in stack.discovered and counts[index] > 1
            else (revision.title, revision.body)
        )
        for index, (revision, head) in enumerate(zip(revisions, heads, strict=True))
    }
    expected_drafts = {
        head: stack.discovered[head].draft if head in stack.discovered else True
        for head in heads
    }
    expected_first_base = expected_first_open_base(plan, stack, repo.base)
    if plan.boundary and plan.boundary.head in heads:
        raise Error("selected PR head collides with the inherited merged boundary")
    verify_unstackable(plan, stack)
    current_live = remote_refs(repo.git_root, remote)
    verify_existing_refs_unchanged(existing_evidence, current_live)
    verify_live_boundary_refs_unchanged(old_states, current_live)
    verify_planned_head_refs_unchanged(planned_head_refs, current_live)
    ref_plan = make_ref_publication_plan(reconciliation, revisions, heads, current_live)
    if ref_plan.updates:
        preflight = atomic_push_command(
            repo.git_root, remote, ref_plan.updates, dry_run=True
        )
        preflight_result = command(preflight, check=False)
        if preflight_result.returncode != 0:
            detail = preflight_result.stderr.strip() or preflight_result.stdout.strip()
            local_state = (
                "; the local stack remains rebased"
                if reconciliation is ReconciliationKind.LOCAL_AUTHORITY
                else ""
            )
            raise Error(
                "preflight atomic push failed; no remote refs were changed"
                + local_state
                + (f":\n{detail}" if detail else "")
            )
    live_after_preflight = remote_refs(repo.git_root, remote)
    verify_existing_refs_unchanged(existing_evidence, live_after_preflight)
    expected_before_publication = {head: current_live.get(head) for head in heads}
    if live_after_preflight.get(repo.base) != base_oid or any(
        live_after_preflight.get(name) != oid
        for name, oid in expected_before_publication.items()
    ):
        raise Error("remote refs changed during planning; replan and retry")
    if operation_id() != planned_operation:
        raise Error("jj operation changed before publication; replan and retry")

    if ref_plan.updates:
        pushed = command(
            atomic_push_command(repo.git_root, remote, ref_plan.updates), check=False
        )
        if pushed.returncode != 0:
            detail = pushed.stderr.strip() or pushed.stdout.strip()
            local_state = (
                "; the local stack remains rebased"
                if reconciliation is ReconciliationKind.LOCAL_AUTHORITY
                else ""
            )
            raise Error(
                "atomic push failed; inspect live refs before retrying"
                + local_state
                + (f":\n{detail}" if detail else "")
            )
        expected_heads = {update.branch: update.new_oid for update in ref_plan.updates}
        after_push = remote_refs(repo.git_root, remote)
        if after_push.get(repo.base) != base_oid:
            raise Error(
                "publication completed, but the base advanced concurrently; "
                "no GitHub metadata was changed"
            )
        if any(after_push.get(name) != oid for name, oid in expected_heads.items()):
            raise Error("publication completed partially; remote heads are unexpected")
        verify_existing_refs_unchanged(omitted_evidence, after_push)
        fetch_exact_branches(repo, remote, expected_heads)
        track_published_branches(remote, expected_heads)
        planned_operation = begin_inspection_phase()
        verify_published_branch_tracking(remote, expected_heads)

    if plan.boundary:
        import_live_base(repo.git_root, remote, repo.base, base_oid)
        planned_operation = begin_inspection_phase()
        verify_planned_bookmarks(revisions, heads)
        for boundary_command in boundary_commands(
            plan.boundary.head,
            base_oid,
            remote,
            repo.git_root,
            current_live.get(plan.boundary.head),
        ):
            if command(boundary_command, check=False).returncode != 0:
                raise Error(
                    "could not complete the merged-boundary advance; GitHub stack "
                    "metadata was not changed, but published remote or local refs may remain"
                )
        planned_operation = begin_inspection_phase()
        refreshed = remote_refs(repo.git_root, remote)
        if (
            refreshed.get(plan.boundary.head) != base_oid
            or refreshed.get(repo.base) != base_oid
        ):
            raise Error(
                "remote merged boundary and base OIDs do not match after boundary "
                "publication; GitHub stack metadata was not changed, but published "
                "remote or local refs may remain"
            )
        fetch_exact_branches(repo, remote, {plan.boundary.head: base_oid})
        track_published_branches(remote, {plan.boundary.head: base_oid})
        planned_operation = begin_inspection_phase()
        verify_published_branch_tracking(remote, {plan.boundary.head: base_oid})

    expected_refs = {
        repo.base: base_oid,
        **{
            head: revision.commit_id
            for revision, head in zip(revisions, heads, strict=True)
        },
    }
    if plan.boundary:
        expected_refs[plan.boundary.head] = base_oid
    live_before_github = remote_refs(repo.git_root, remote)
    verify_existing_refs_unchanged(omitted_evidence, live_before_github)
    if any(live_before_github.get(name) != oid for name, oid in expected_refs.items()):
        raise Error("remote refs changed before GitHub mutation; inspect and retry")
    if operation_id() != planned_operation:
        raise Error("jj operation changed before GitHub mutation; replan and retry")
    if old_stack.node_id is not None:
        expected_base_refs = dict(expected_refs)
        if plan.refresh_base and plan.boundary:
            expected_base_refs.pop(plan.boundary.head, None)
        verify_stack_snapshot_unchanged(
            old_stack,
            fetch_stack(old_stack.node_id, gh_env, repo.git_root),
            expected_refs,
            expected_base_refs,
        )

    if plan.kind in {
        TopologyKind.FULLY_OPEN_REBUILD,
        TopologyKind.MERGED_PREFIX_REBUILD,
    }:
        unstack = ["gh", "stack", "unstack", str(plan.stack_number)]
        if command(unstack, cwd=repo.git_root, env=gh_env, check=False).returncode != 0:
            raise Error(
                "could not unstack GitHub stack; the stack may be partially changed"
            )
        verify_unstacked(stack, repo.name_with_owner, gh_env, repo.git_root)

    if plan.refresh_base and plan.boundary:
        first = stack.discovered[heads[0]]
        for base in (repo.base, plan.boundary.head):
            result = command(
                ["gh", "pr", "edit", first.url, "--base", base],
                cwd=repo.git_root,
                env=gh_env,
                check=False,
            )
            if result.returncode != 0:
                raise Error(
                    f"could not refresh base of {first.url}; stack remains unstacked"
                )

    if link := link_command(plan, stack, repo, remote):
        temporary_heads = {
            head: revision.commit_id
            for revision, head in zip(revisions, heads, strict=True)
            if head in plan.link_heads and head not in stack.discovered
        }
        if run_stack_link(link, repo.git_root, gh_env, temporary_heads).returncode != 0:
            raise Error(
                "gh stack link failed; pushed bookmarks remain and PRs may be unstacked"
            )

    discovered = discover_pull_requests(
        repo.name_with_owner, heads, gh_env, repo.git_root
    )
    if set(discovered) != set(heads):
        raise Error(
            "stack was updated, but not all selected pull requests could be found"
        )
    synchronize_pull_requests(heads, discovered, metadata, gh_env, repo.git_root)
    final = verify_final(
        repo,
        revisions,
        heads,
        metadata,
        expected_drafts,
        expected_first_base,
        stack.merged,
        stack.node_id if stack.merged else None,
        base_oid,
        counts,
        gh_env,
    )
    time.sleep(1)
    stable_refs = remote_refs(repo.git_root, remote)
    verify_existing_refs_unchanged(omitted_evidence, stable_refs)
    if stable_refs.get(repo.base) != base_oid or any(
        stable_refs.get(head) != revision.commit_id
        for revision, head in zip(revisions, heads, strict=True)
    ):
        raise Error(
            "GitHub restacked again after publication; inspect the managed suffix"
        )
    final = verify_final(
        repo,
        revisions,
        heads,
        metadata,
        expected_drafts,
        expected_first_base,
        stack.merged,
        stack.node_id if stack.merged else None,
        base_oid,
        counts,
        gh_env,
    )
    verify_detached_omissions(omitted_evidence, repo, remote, gh_env)
    evidence_by_number = {item.pr.number: item for item in omitted_evidence}
    for number in sorted(close_numbers):
        item = evidence_by_number[number]
        current = verify_detached_omissions((item,), repo, remote, gh_env)[number]
        try:
            close_omitted_pull_request(current, gh_env, repo.git_root)
        except Error as error:
            raise Error(
                f"stack publication succeeded, but closing PR #{number} could not be "
                "completed or verified; it remains detached and branch "
                f"{item.pr.head} was retained; inspect whether the PR is open or closed: "
                f"{error}"
            ) from error
        verify_existing_refs_unchanged((item,), remote_refs(repo.git_root, remote))
    # Keep stdout as the single machine-readable success result; diagnostics and
    # secondary outcomes belong on stderr.
    print(f"Published stack {final.number}: {repo.url}/stacks/{final.number}")
    for item in omitted_evidence:
        if item.pr.number in close_numbers:
            action = "closed"
        else:
            action = "left open"
        print(
            f"Omitted PR #{item.pr.number} detached and {action}; "
            f"branch {item.pr.head} retained at {item.live_oid[:8]}",
            file=sys.stderr,
        )
    if stack.number is not None and final.number != stack.number:
        print(
            f"Replaced stack {stack.number} with stack {final.number}", file=sys.stderr
        )


if __name__ == "__main__":
    try:
        main()
    except Error as error:
        print(f"jj stack: {error}", file=sys.stderr)
        raise SystemExit(1)
